// 灰阶基底（占位复用 Airbus_A320neo 灰阶图）
#define IMAGEFILE  "src/gfx/Airbus/A320/A320neo/(0)Greyscale.png"
purchase_sprite(AIRBUS_A220_100, 310, 0, 48, 23, -24, -12)
AIRBUS_A220_100_sprite_layout_template(AIRBUS_A220_100_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A320/A320neo/Aegean.png"
AIRBUS_A220_100_sprite_layout_template(AIRBUS_A220_100_Aegean)
