{
  15: AIRBUS_A220_100_AirCairo_Climbing;
  18: AIRBUS_A220_100_AirCairo_Flight;
  21: AIRBUS_A220_100_AirCairo_Landing;
  22: AIRBUS_A220_100_AirCairo_Touchdown;
      AIRBUS_A220_100_AirCairo_Grounded;
}

