switch (FEAT_AIRCRAFT, SELF, AIRBUS_A220_100_sprites, cargo_subtype)
{
  1: AIRBUS_A220_100_Aegean;
  2: AIRBUS_A220_100_AirCairo;
  3: AIRBUS_A220_100_AirMalta;
  4: AIRBUS_A220_100_AtlanticAirways;
  5: AIRBUS_A220_100_Austrian;
     AIRBUS_A220_100_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A220_100_running_cost_factor, flight_state())
{
  plane_RC(73)
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A220_100_speed, flight_state())
{
  // [speed-constant] 巡航速度恒定，不随飞行状态变化。
  // OpenTTD 将速度属性回调（CB36）的结果缓存于 cached_max_speed，仅在载具
  // 创建、机场状态切换和读档时刷新；按 flight_state 返回不同速度会让缓存
  // 卡在旧值上（起飞后停在跑道速度；读档后跑道速度变成巡航速度）。
  // 滑行/进近/刹车减速由游戏原生状态机按巡航速度自动派生，无需在此压低。
  return plane_speed_kmh(870); // cruise, keep in sync with purchase_speed
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A220_100_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A220_100_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_AIRBUS_A220_100);
  1: string(STR_VLIV_AEGEAN_AIRLINES);
  2: string(STR_VLIV_AIR_CAIRO);
  3: string(STR_VLIV_AIR_MALTA);
  4: string(STR_VLIV_ATLANTIC_AIRWAYS);
  5: string(STR_VLIV_AUSTRIAN_AIRLINES);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A220_100_cargo_subtype_capacity, cargo_subtype)
{
  1: return 120;
  2: return 120;
  3: return 120;
  4: return 120;
  5: return 120;
     return 120;
}

item (FEAT_AIRCRAFT, AIRBUS_A220_100)
{
  property
  {
    name: string(STR_AIRV_AIRBUS_A220_100);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2016), 1, 1);
    vehicle_life: 26;
    model_life: get_model_life(2016,2050);
    retire_early: get_retire_early(2016,2050);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 22;
    passenger_capacity: 116;
    mail_capacity: 12;
    acceleration: 27;
    range: 1145;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: AIRBUS_A220_100_sprites;
    purchase: AIRBUS_A220_100_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: AIRBUS_A220_100_cargo_subtype_text;
    passenger_capacity: AIRBUS_A220_100_cargo_subtype_capacity;
    speed: AIRBUS_A220_100_speed;
    running_cost_factor: AIRBUS_A220_100_running_cost_factor;
    sound_effect: AIRBUS_A220_100_sound_effect;

    cost_factor: 80;
    purchase_running_cost_factor: 71;
    purchase_speed: plane_speed_kmh(870);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, AIRBUS_A220_100)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, AIRBUS_A220_100)
  {
    property
    { range: 1145; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, AIRBUS_A220_100)
  {
    property
    { range: 1720; }
  }
}
