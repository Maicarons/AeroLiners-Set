  15: AIRBUS_A220_100_Greyscale_Climbing;
  18: AIRBUS_A220_100_Greyscale_Flight;
  21: AIRBUS_A220_100_Greyscale_Landing;
  22: AIRBUS_A220_100_Greyscale_Touchdown;
      AIRBUS_A220_100_Greyscale_Grounded;
}

