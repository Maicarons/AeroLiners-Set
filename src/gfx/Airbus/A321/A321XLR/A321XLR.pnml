// 灰阶基底（占位复用 Airbus_A320_200 灰阶图）
#define IMAGEFILE  "src/gfx/Airbus/A320/A320-200/(0)Greyscale.png"
purchase_sprite(AIRBUS_A321XLR, 310, 0, 48, 23, -24, -12)
AIRBUS_A321XLR_sprite_layout_template(AIRBUS_A321XLR_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A320/A320-200/Aegan.png"
AIRBUS_A321XLR_sprite_layout_template(AIRBUS_A321XLR_Aegan)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A320/A320-200/AerLingus.png"
AIRBUS_A321XLR_sprite_layout_template(AIRBUS_A321XLR_AerLingus)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A320/A320-200/Aeroflot.png"
AIRBUS_A321XLR_sprite_layout_template(AIRBUS_A321XLR_Aeroflot)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A320/A320-200/AirArabia.png"
AIRBUS_A321XLR_sprite_layout_template(AIRBUS_A321XLR_AirArabia)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A320/A320-200/AirAsia.png"
AIRBUS_A321XLR_sprite_layout_template(AIRBUS_A321XLR_AirAsia)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A321XLR_Greyscale, flight_state())
{
  15: AIRBUS_A321XLR_Greyscale_Climbing;
  18: AIRBUS_A321XLR_Greyscale_Flight;
  21: AIRBUS_A321XLR_Greyscale_Landing;
  22: AIRBUS_A321XLR_Greyscale_Touchdown;
      AIRBUS_A321XLR_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A321XLR_Aegan, flight_state())
{
  15: AIRBUS_A321XLR_Aegan_Climbing;
  18: AIRBUS_A321XLR_Aegan_Flight;
  21: AIRBUS_A321XLR_Aegan_Landing;
  22: AIRBUS_A321XLR_Aegan_Touchdown;
      AIRBUS_A321XLR_Aegan_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A321XLR_AerLingus, flight_state())
{
  15: AIRBUS_A321XLR_AerLingus_Climbing;
  18: AIRBUS_A321XLR_AerLingus_Flight;
  21: AIRBUS_A321XLR_AerLingus_Landing;
  22: AIRBUS_A321XLR_AerLingus_Touchdown;
      AIRBUS_A321XLR_AerLingus_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A321XLR_Aeroflot, flight_state())
{
  15: AIRBUS_A321XLR_Aeroflot_Climbing;
  18: AIRBUS_A321XLR_Aeroflot_Flight;
  21: AIRBUS_A321XLR_Aeroflot_Landing;
  22: AIRBUS_A321XLR_Aeroflot_Touchdown;
      AIRBUS_A321XLR_Aeroflot_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A321XLR_AirArabia, flight_state())
{
  15: AIRBUS_A321XLR_AirArabia_Climbing;
  18: AIRBUS_A321XLR_AirArabia_Flight;
  21: AIRBUS_A321XLR_AirArabia_Landing;
  22: AIRBUS_A321XLR_AirArabia_Touchdown;
      AIRBUS_A321XLR_AirArabia_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A321XLR_AirAsia, flight_state())
{
  15: AIRBUS_A321XLR_AirAsia_Climbing;
  18: AIRBUS_A321XLR_AirAsia_Flight;
  21: AIRBUS_A321XLR_AirAsia_Landing;
  22: AIRBUS_A321XLR_AirAsia_Touchdown;
      AIRBUS_A321XLR_AirAsia_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A321XLR_sprites, cargo_subtype)
{
  1: AIRBUS_A321XLR_Aegan;
  2: AIRBUS_A321XLR_AerLingus;
  3: AIRBUS_A321XLR_Aeroflot;
  4: AIRBUS_A321XLR_AirArabia;
  5: AIRBUS_A321XLR_AirAsia;
     AIRBUS_A321XLR_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A321XLR_running_cost_factor, flight_state())
{
  plane_RC(77)
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A321XLR_speed, flight_state())
{
  12..13: return plane_speed_kmh(257); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(362); // airplane climbing after take-off
      18: return plane_speed_kmh(833); // heading for tower contact point
  16..20: return plane_speed_kmh(467); // in flight
  21..22: return plane_speed_kmh(233); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A321XLR_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A321XLR_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_AIRBUS_A321XLR);
  1: string(STR_VLIV_AEGEAN_AIRLINES);
  2: string(STR_VLIV_AER_LINGUS);
  3: string(STR_VLIV_AEROFLOT);
  4: string(STR_VLIV_AIR_ARABIA);
  5: string(STR_VLIV_AIR_ASIA);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A321XLR_cargo_subtype_capacity, cargo_subtype)
{
  1: return 210;
  2: return 210;
  3: return 210;
  4: return 210;
  5: return 210;
     return 210;
}

item (FEAT_AIRCRAFT, AIRBUS_A321XLR)
{
  property
  {
    name: string(STR_AIRV_AIRBUS_A321XLR);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2024), 1, 1);
    vehicle_life: 18;
    model_life: get_model_life(1989,2050);
    retire_early: get_retire_early(1989,2050);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 22;
    passenger_capacity: 206;
    mail_capacity: 21;
    acceleration: 27;
    range: 1582;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: AIRBUS_A321XLR_sprites;
    purchase: AIRBUS_A321XLR_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: AIRBUS_A321XLR_cargo_subtype_text;
    passenger_capacity: AIRBUS_A321XLR_cargo_subtype_capacity;
    speed: AIRBUS_A321XLR_speed;
    running_cost_factor: AIRBUS_A321XLR_running_cost_factor;
    sound_effect: AIRBUS_A321XLR_sound_effect;

    cost_factor: 73;
    purchase_running_cost_factor: 77;
    purchase_speed: plane_speed_kmh(833);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, AIRBUS_A321XLR)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, AIRBUS_A321XLR)
  {
    property
    { range: 1582; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, AIRBUS_A321XLR)
  {
    property
    { range: 2381; }
  }
}
