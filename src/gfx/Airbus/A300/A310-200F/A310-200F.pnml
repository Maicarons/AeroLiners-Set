#define IMAGEFILE  "src/gfx/Airbus/A300/A310-200F/(0)Greyscale.png"
purchase_sprite(Airbus_A310_200F, 315, 1, 53, 25, -27, -13)
Airbus_A310_200F_sprite_layout_template(Airbus_A310_200F_Greyscale) 
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A300/A310-200F/FedEx.png"
Airbus_A310_200F_sprite_layout_template(Airbus_A310_200F_FedEx) 
#undef IMAGEFILE


switch (FEAT_AIRCRAFT, SELF, Airbus_A310_200F_Greyscale, flight_state())
{
  15: Airbus_A310_200F_Greyscale_Climbing;
  18: Airbus_A310_200F_Greyscale_Flight;
  21: Airbus_A310_200F_Greyscale_Landing;
  22: Airbus_A310_200F_Greyscale_Touchdown;
      Airbus_A310_200F_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, Airbus_A310_200F_FedEx, flight_state())
{
  15: Airbus_A310_200F_FedEx_Climbing;
  18: Airbus_A310_200F_FedEx_Flight;
  21: Airbus_A310_200F_FedEx_Landing;
  22: Airbus_A310_200F_FedEx_Touchdown;
      Airbus_A310_200F_FedEx_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, Airbus_A310_200F_sprites, cargo_subtype)
{
  1: Airbus_A310_200F_FedEx;
     Airbus_A310_200F_Greyscale;
}
                             
switch (FEAT_AIRCRAFT, SELF, Airbus_A310_200F_running_cost_factor, flight_state())
{
  plane_RC(126)
}

switch (FEAT_AIRCRAFT, SELF, Airbus_A310_200F_speed, flight_state())
{
  // [speed-constant] 巡航速度恒定，不随飞行状态变化。
  // OpenTTD 将速度属性回调（CB36）的结果缓存于 cached_max_speed，仅在载具
  // 创建、机场状态切换和读档时刷新；按 flight_state 返回不同速度会让缓存
  // 卡在旧值上（起飞后停在跑道速度；读档后跑道速度变成巡航速度）。
  // 滑行/进近/刹车减速由游戏原生状态机按巡航速度自动派生，无需在此压低。
  return plane_speed_kmh(871); // cruise, keep in sync with purchase_speed
}

switch (FEAT_AIRCRAFT, SELF, Airbus_A310_200F_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_AIRBUS);
  1: string(STR_VLIV_FEDEX);
     return CB_RESULT_NO_TEXT;
}

item (FEAT_AIRCRAFT, Airbus_A310_200F)
{
  property
  {
    name: string(STR_AIRV_AIRBUS_A310_200F);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1984), 1, 1);
    vehicle_life: 30;
    model_life: get_model_life(1984,1988);
    retire_early: get_retire_early(1984,1988);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_LARGE;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC, AIRCRAFT_FLAG_AUTOREFIT);
    cargo_allow_refit: [BATT, CERE, JAVA, COLA, CTCD, DIAM, DYES, ENSP, FMSP, FERT, FICR, FISH, FZDR, FOOD, FRUT, FRVG, GLAS, GOLD, GOOD, LVST, MAIL, MAIZ, MNSP, MILK, OIL_, OLSD, PAPR, PLST, PLAS, RSGR, RFPR, RUBR, STEL, SUGR, SGBT, SGCN, SWET, TOFF, TOYS, VALU, VEHI, WHEA, WDPR, WOOL];
    reliability_decay: 20;
    loading_speed: 10;
    passenger_capacity: 0;
    mail_capacity: 0;
    acceleration: 27;                  // in 27,75 mph/day
    range: 1082;
    sound_effect: SOUND_TAKEOFF_JET_BIG;
  }
  graphics {
    default: Airbus_A310_200F_sprites;
    purchase: Airbus_A310_200F_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: Airbus_A310_200F_cargo_subtype_text;
    speed: Airbus_A310_200F_speed;
    running_cost_factor: Airbus_A310_200F_running_cost_factor;
    mail_capacity: return 325;

    cost_factor: 134; 
    purchase_running_cost_factor: 126;
    purchase_speed: plane_speed_kmh(871); 
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, Airbus_A310_200F)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, Airbus_A310_200F)
  {
    property
    { range: 1082; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, Airbus_A310_200F)
  {
    property
    { range: 1623; }
  }
}
