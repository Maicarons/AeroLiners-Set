// 灰阶基底（占位复用 Airbus_A330_300 灰阶图）
#define IMAGEFILE  "src/gfx/Airbus/A330/A330-300/(0)Greyscale.png"
purchase_sprite(AIRBUS_A330_800NEO, 415, 1, 69, 34, -35, -17)
AIRBUS_A330_800NEO_sprite_layout_template(AIRBUS_A330_800NEO_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A330/A330-300/AirCanada.png"
AIRBUS_A330_800NEO_sprite_layout_template(AIRBUS_A330_800NEO_AirCanada)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A330/A330-300/AirEuropa.png"
AIRBUS_A330_800NEO_sprite_layout_template(AIRBUS_A330_800NEO_AirEuropa)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A330/A330-300/American.png"
AIRBUS_A330_800NEO_sprite_layout_template(AIRBUS_A330_800NEO_American)
#undef IMAGEFILE
