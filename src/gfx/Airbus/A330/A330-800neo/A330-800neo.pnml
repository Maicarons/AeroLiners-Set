AIRBUS_A330_800NEO_sprite_layout_template(AIRBUS_A330_800NEO_CatheyPacific)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A330_800NEO_Greyscale, flight_state())
{
  15: AIRBUS_A330_800NEO_Greyscale_Climbing;
  18: AIRBUS_A330_800NEO_Greyscale_Flight;
  21: AIRBUS_A330_800NEO_Greyscale_Landing;
  22: AIRBUS_A330_800NEO_Greyscale_Touchdown;
      AIRBUS_A330_800NEO_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A330_800NEO_AirCanada, flight_state())
{
  15: AIRBUS_A330_800NEO_AirCanada_Climbing;
  18: AIRBUS_A330_800NEO_AirCanada_Flight;
  21: AIRBUS_A330_800NEO_AirCanada_Landing;
  22: AIRBUS_A330_800NEO_AirCanada_Touchdown;
      AIRBUS_A330_800NEO_AirCanada_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A330_800NEO_AirEuropa, flight_state())
{
  15: AIRBUS_A330_800NEO_AirEuropa_Climbing;
  18: AIRBUS_A330_800NEO_AirEuropa_Flight;
  21: AIRBUS_A330_800NEO_AirEuropa_Landing;
  22: AIRBUS_A330_800NEO_AirEuropa_Touchdown;
      AIRBUS_A330_800NEO_AirEuropa_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A330_800NEO_American, flight_state())
{
  15: AIRBUS_A330_800NEO_American_Climbing;
  18: AIRBUS_A330_800NEO_American_Flight;
  21: AIRBUS_A330_800NEO_American_Landing;
  22: AIRBUS_A330_800NEO_American_Touchdown;
      AIRBUS_A330_800NEO_American_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A330_800NEO_Asiana, flight_state())
{
  15: AIRBUS_A330_800NEO_Asiana_Climbing;
  18: AIRBUS_A330_800NEO_Asiana_Flight;
  21: AIRBUS_A330_800NEO_Asiana_Landing;
  22: AIRBUS_A330_800NEO_Asiana_Touchdown;
      AIRBUS_A330_800NEO_Asiana_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A330_800NEO_CatheyPacific, flight_state())
{
  15: AIRBUS_A330_800NEO_CatheyPacific_Climbing;
  18: AIRBUS_A330_800NEO_CatheyPacific_Flight;
  21: AIRBUS_A330_800NEO_CatheyPacific_Landing;
  22: AIRBUS_A330_800NEO_CatheyPacific_Touchdown;
      AIRBUS_A330_800NEO_CatheyPacific_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A330_800NEO_sprites, cargo_subtype)
{
  1: AIRBUS_A330_800NEO_AirCanada;
  2: AIRBUS_A330_800NEO_AirEuropa;
  3: AIRBUS_A330_800NEO_American;
  4: AIRBUS_A330_800NEO_Asiana;
  5: AIRBUS_A330_800NEO_CatheyPacific;
     AIRBUS_A330_800NEO_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A330_800NEO_running_cost_factor, flight_state())
{
  plane_RC(166)
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A330_800NEO_speed, flight_state())
{
  12..13: return plane_speed_kmh(281); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(483); // airplane climbing after take-off
      18: return plane_speed_kmh(871); // heading for tower contact point
  16..20: return plane_speed_kmh(443); // in flight
  21..22: return plane_speed_kmh(241); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A330_800NEO_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A330_800NEO_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_AIRBUS_A330_800NEO);
  1: string(STR_VLIV_AIR_CANADA);
  2: string(STR_VLIV_AIR_EUROPA);
  3: string(STR_VLIV_AMERICAN_AIRLINES);
  4: string(STR_VLIV_ASIANA_AIRLINES);
  5: string(STR_VLIV_CATHAY_PACIFIC);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, AIRBUS_A330_800NEO_cargo_subtype_capacity, cargo_subtype)
{
  1: return 264;
  2: return 264;
  3: return 264;
  4: return 264;
  5: return 264;
     return 264;
}

item (FEAT_AIRCRAFT, AIRBUS_A330_800NEO)
{
  property
  {
    name: string(STR_AIRV_AIRBUS_A330_800NEO);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2020), 1, 1);
    vehicle_life: 25;
    model_life: get_model_life(1994,2050);
    retire_early: get_retire_early(1994,2050);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_LARGE;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 43;
    passenger_capacity: 257;
    mail_capacity: 26;
    acceleration: 27;
    range: 2727;
    sound_effect: SOUND_TAKEOFF_JET_BIG;
  }
  graphics {
    default: AIRBUS_A330_800NEO_sprites;
    purchase: AIRBUS_A330_800NEO_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: AIRBUS_A330_800NEO_cargo_subtype_text;
    passenger_capacity: AIRBUS_A330_800NEO_cargo_subtype_capacity;
    speed: AIRBUS_A330_800NEO_speed;
    running_cost_factor: AIRBUS_A330_800NEO_running_cost_factor;
    sound_effect: AIRBUS_A330_800NEO_sound_effect;

    cost_factor: 187;
    purchase_running_cost_factor: 166;
    purchase_speed: plane_speed_kmh(871);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, AIRBUS_A330_800NEO)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, AIRBUS_A330_800NEO)
  {
    property
    { range: 2727; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, AIRBUS_A330_800NEO)
  {
    property
    { range: 4090; }
  }
}
