purchase_sprite(PILATUS_PC24, 275, 1, 48, 20, -24, -10)
PILATUS_PC24_sprite_layout_template(PILATUS_PC24_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Fokker/F100/AirBerlin.png"
