switch (FEAT_AIRCRAFT, SELF, PILATUS_PC24_sprites, cargo_subtype)
{
  1: PILATUS_PC24_AirBerlin;
  2: PILATUS_PC24_AirDolomiti;
  3: PILATUS_PC24_AirInter;
  4: PILATUS_PC24_AirNiugini;
  5: PILATUS_PC24_Alliance;
     PILATUS_PC24_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, PILATUS_PC24_running_cost_factor, flight_state())
{
  plane_RC(61)
}

switch (FEAT_AIRCRAFT, SELF, PILATUS_PC24_speed, flight_state())
{
  // [speed-constant] 巡航速度恒定，不随飞行状态变化。
  // OpenTTD 将速度属性回调（CB36）的结果缓存于 cached_max_speed，仅在载具
  // 创建、机场状态切换和读档时刷新；按 flight_state 返回不同速度会让缓存
  // 卡在旧值上（起飞后停在跑道速度；读档后跑道速度变成巡航速度）。
  // 滑行/进近/刹车减速由游戏原生状态机按巡航速度自动派生，无需在此压低。
  return plane_speed_kmh(810); // cruise, keep in sync with purchase_speed
}

switch (FEAT_AIRCRAFT, SELF, PILATUS_PC24_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, PILATUS_PC24_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_PILATUS_PC24);
  1: string(STR_VLIV_AIR_BERLIN);
  2: string(STR_VLIV_AIR_DOLOMITI);
  3: string(STR_VLIV_AIR_INTER);
  4: string(STR_VLIV_AIR_NIUGINI);
  5: string(STR_VLIV_ALLIANCE_AIRLINES);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, PILATUS_PC24_cargo_subtype_capacity, cargo_subtype)
{
  1: return 12;
  2: return 12;
  3: return 12;
  4: return 12;
  5: return 12;
     return 12;
}

item (FEAT_AIRCRAFT, PILATUS_PC24)
{
  property
  {
    name: string(STR_AIRV_PILATUS_PC24);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2018), 1, 1);
    vehicle_life: 25;
    model_life: get_model_life(1986,1997);
    retire_early: get_retire_early(1986,1997);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 19;
    passenger_capacity: 10;
    mail_capacity: 1;
    acceleration: 27;
    range: 673;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: PILATUS_PC24_sprites;
    purchase: PILATUS_PC24_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: PILATUS_PC24_cargo_subtype_text;
    passenger_capacity: PILATUS_PC24_cargo_subtype_capacity;
    speed: PILATUS_PC24_speed;
    running_cost_factor: PILATUS_PC24_running_cost_factor;
    sound_effect: PILATUS_PC24_sound_effect;

    cost_factor: 27;
    purchase_running_cost_factor: 61;
    purchase_speed: plane_speed_kmh(810);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, PILATUS_PC24)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, PILATUS_PC24)
  {
    property
    { range: 673; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, PILATUS_PC24)
  {
    property
    { range: 1009; }
  }
}
