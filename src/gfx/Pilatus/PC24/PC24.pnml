{
  15: PILATUS_PC24_Greyscale_Climbing;
  18: PILATUS_PC24_Greyscale_Flight;
  21: PILATUS_PC24_Greyscale_Landing;
  22: PILATUS_PC24_Greyscale_Touchdown;
      PILATUS_PC24_Greyscale_Grounded;
}

