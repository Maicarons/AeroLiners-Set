{
  15: PILATUS_PC24_AirBerlin_Climbing;
  18: PILATUS_PC24_AirBerlin_Flight;
  21: PILATUS_PC24_AirBerlin_Landing;
  22: PILATUS_PC24_AirBerlin_Touchdown;
      PILATUS_PC24_AirBerlin_Grounded;
}

