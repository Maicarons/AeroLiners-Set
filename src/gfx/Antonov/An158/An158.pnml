// 灰阶基底（占位复用 Embraer_E190STD 灰阶图）
#define IMAGEFILE  "src/gfx/Embraer/E190/E190STD/(0)Greyscale.png"
purchase_sprite(ANTONOV_AN158, 255, 1, 45, 21, -23, -11)
ANTONOV_AN158_sprite_layout_template(ANTONOV_AN158_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Embraer/E190/E190STD/Alitalia.png"
ANTONOV_AN158_sprite_layout_template(ANTONOV_AN158_Alitalia)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Embraer/E190/E190STD/BACityflyer.png"
ANTONOV_AN158_sprite_layout_template(ANTONOV_AN158_BACityflyer)
#undef IMAGEFILE
