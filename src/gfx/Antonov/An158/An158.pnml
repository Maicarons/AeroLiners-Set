ANTONOV_AN158_sprite_layout_template(ANTONOV_AN158_KLMCityhopper)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN158_Greyscale, flight_state())
{
  15: ANTONOV_AN158_Greyscale_Climbing;
  18: ANTONOV_AN158_Greyscale_Flight;
  21: ANTONOV_AN158_Greyscale_Landing;
  22: ANTONOV_AN158_Greyscale_Touchdown;
      ANTONOV_AN158_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN158_Alitalia, flight_state())
{
  15: ANTONOV_AN158_Alitalia_Climbing;
  18: ANTONOV_AN158_Alitalia_Flight;
  21: ANTONOV_AN158_Alitalia_Landing;
  22: ANTONOV_AN158_Alitalia_Touchdown;
      ANTONOV_AN158_Alitalia_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN158_BACityflyer, flight_state())
{
  15: ANTONOV_AN158_BACityflyer_Climbing;
  18: ANTONOV_AN158_BACityflyer_Flight;
  21: ANTONOV_AN158_BACityflyer_Landing;
  22: ANTONOV_AN158_BACityflyer_Touchdown;
      ANTONOV_AN158_BACityflyer_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN158_BulgariaAir, flight_state())
{
  15: ANTONOV_AN158_BulgariaAir_Climbing;
  18: ANTONOV_AN158_BulgariaAir_Flight;
  21: ANTONOV_AN158_BulgariaAir_Landing;
  22: ANTONOV_AN158_BulgariaAir_Touchdown;
      ANTONOV_AN158_BulgariaAir_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN158_HOP, flight_state())
{
  15: ANTONOV_AN158_HOP_Climbing;
  18: ANTONOV_AN158_HOP_Flight;
  21: ANTONOV_AN158_HOP_Landing;
  22: ANTONOV_AN158_HOP_Touchdown;
      ANTONOV_AN158_HOP_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN158_KLMCityhopper, flight_state())
{
  15: ANTONOV_AN158_KLMCityhopper_Climbing;
  18: ANTONOV_AN158_KLMCityhopper_Flight;
  21: ANTONOV_AN158_KLMCityhopper_Landing;
  22: ANTONOV_AN158_KLMCityhopper_Touchdown;
      ANTONOV_AN158_KLMCityhopper_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN158_sprites, cargo_subtype)
{
  1: ANTONOV_AN158_Alitalia;
  2: ANTONOV_AN158_BACityflyer;
  3: ANTONOV_AN158_BulgariaAir;
  4: ANTONOV_AN158_HOP;
  5: ANTONOV_AN158_KLMCityhopper;
     ANTONOV_AN158_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN158_running_cost_factor, flight_state())
{
  plane_RC(29)
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN158_speed, flight_state())
{
  12..13: return plane_speed_kmh(241); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(410); // airplane climbing after take-off
      18: return plane_speed_kmh(870); // heading for tower contact point
  16..20: return plane_speed_kmh(427); // in flight
  21..22: return plane_speed_kmh(273); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN158_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN158_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_ANTONOV_AN158);
  1: string(STR_VLIV_ALITALIA);
  2: string(STR_VLIV_BRITISH_AIRWAYS_UNION_FLAG);
  3: string(STR_VLIV_BULGARIA_AIR);
  4: string(STR_VLIV_HOP);
  5: string(STR_VLIV_KLM_CITYHOPPER);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN158_cargo_subtype_capacity, cargo_subtype)
{
  1: return 90;
  2: return 90;
  3: return 90;
  4: return 90;
  5: return 90;
     return 90;
}

item (FEAT_AIRCRAFT, ANTONOV_AN158)
{
  property
  {
    name: string(STR_AIRV_ANTONOV_AN158);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2010), 1, 1);
    vehicle_life: 30;
    model_life: get_model_life(2004,2259);
    retire_early: get_retire_early(2004,2259);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 19;
    passenger_capacity: 90;
    mail_capacity: 9;
    acceleration: 27;
    range: 455;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: ANTONOV_AN158_sprites;
    purchase: ANTONOV_AN158_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: ANTONOV_AN158_cargo_subtype_text;
    passenger_capacity: ANTONOV_AN158_cargo_subtype_capacity;
    speed: ANTONOV_AN158_speed;
    running_cost_factor: ANTONOV_AN158_running_cost_factor;
    sound_effect: ANTONOV_AN158_sound_effect;

    cost_factor: 65;
    purchase_running_cost_factor: 29;
    purchase_speed: plane_speed_kmh(870);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, ANTONOV_AN158)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, ANTONOV_AN158)
  {
    property
    { range: 455; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, ANTONOV_AN158)
  {
    property
    { range: 683; }
  }
}
