{
  15: ANTONOV_AN148_Greyscale_Climbing;
  18: ANTONOV_AN148_Greyscale_Flight;
  21: ANTONOV_AN148_Greyscale_Landing;
  22: ANTONOV_AN148_Greyscale_Touchdown;
      ANTONOV_AN148_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN148_Alitalia, flight_state())
{
  15: ANTONOV_AN148_Alitalia_Climbing;
  18: ANTONOV_AN148_Alitalia_Flight;
  21: ANTONOV_AN148_Alitalia_Landing;
  22: ANTONOV_AN148_Alitalia_Touchdown;
      ANTONOV_AN148_Alitalia_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN148_BACityflyer, flight_state())
{
  15: ANTONOV_AN148_BACityflyer_Climbing;
  18: ANTONOV_AN148_BACityflyer_Flight;
  21: ANTONOV_AN148_BACityflyer_Landing;
  22: ANTONOV_AN148_BACityflyer_Touchdown;
      ANTONOV_AN148_BACityflyer_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN148_BulgariaAir, flight_state())
{
  15: ANTONOV_AN148_BulgariaAir_Climbing;
  18: ANTONOV_AN148_BulgariaAir_Flight;
  21: ANTONOV_AN148_BulgariaAir_Landing;
  22: ANTONOV_AN148_BulgariaAir_Touchdown;
      ANTONOV_AN148_BulgariaAir_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN148_HOP, flight_state())
