switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN148_sprites, cargo_subtype)
{
  1: ANTONOV_AN148_Alitalia;
  2: ANTONOV_AN148_BACityflyer;
  3: ANTONOV_AN148_BulgariaAir;
  4: ANTONOV_AN148_HOP;
  5: ANTONOV_AN148_KLMCityhopper;
     ANTONOV_AN148_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN148_running_cost_factor, flight_state())
{
  plane_RC(29)
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN148_speed, flight_state())
{
  // [speed-constant] 巡航速度恒定，不随飞行状态变化。
  // OpenTTD 将速度属性回调（CB36）的结果缓存于 cached_max_speed，仅在载具
  // 创建、机场状态切换和读档时刷新；按 flight_state 返回不同速度会让缓存
  // 卡在旧值上（起飞后停在跑道速度；读档后跑道速度变成巡航速度）。
  // 滑行/进近/刹车减速由游戏原生状态机按巡航速度自动派生，无需在此压低。
  return plane_speed_kmh(870); // cruise, keep in sync with purchase_speed
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN148_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN148_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_ANTONOV_AN148);
  1: string(STR_VLIV_ALITALIA);
  2: string(STR_VLIV_BRITISH_AIRWAYS_UNION_FLAG);
  3: string(STR_VLIV_BULGARIA_AIR);
  4: string(STR_VLIV_HOP);
  5: string(STR_VLIV_KLM_CITYHOPPER);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, ANTONOV_AN148_cargo_subtype_capacity, cargo_subtype)
{
  1: return 80;
  2: return 80;
  3: return 80;
  4: return 80;
  5: return 80;
     return 80;
}

item (FEAT_AIRCRAFT, ANTONOV_AN148)
{
  property
  {
    name: string(STR_AIRV_ANTONOV_AN148);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2009), 1, 1);
    vehicle_life: 30;
    model_life: get_model_life(2004,2259);
    retire_early: get_retire_early(2004,2259);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 19;
    passenger_capacity: 68;
    mail_capacity: 8;
    acceleration: 27;
    range: 800;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: ANTONOV_AN148_sprites;
    purchase: ANTONOV_AN148_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: ANTONOV_AN148_cargo_subtype_text;
    passenger_capacity: ANTONOV_AN148_cargo_subtype_capacity;
    speed: ANTONOV_AN148_speed;
    running_cost_factor: ANTONOV_AN148_running_cost_factor;
    sound_effect: ANTONOV_AN148_sound_effect;

    cost_factor: 50;
    purchase_running_cost_factor: 29;
    purchase_speed: plane_speed_kmh(870);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, ANTONOV_AN148)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, ANTONOV_AN148)
  {
    property
    { range: 800; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, ANTONOV_AN148)
  {
    property
    { range: 1200; }
  }
}
