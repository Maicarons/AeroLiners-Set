// 灰阶基底（占位复用 ATR_42_500 灰阶图）

// 灰阶基底（占位复用 ATR_42_600 灰阶图）
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/(0)Greyscale.png"
purchase_sprite(LET_L410, 285, 1, 46, 23, -23, -12)
LET_L410_sprite_layout_template(LET_L410_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/AirFrance.png"
LET_L410_sprite_layout_template(LET_L410_AirFrance)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/CSA.png"
LET_L410_sprite_layout_template(LET_L410_CSA)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/Satena.png"
LET_L410_sprite_layout_template(LET_L410_Satena)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, LET_L410_Greyscale, flight_state())
{
  15: LET_L410_Greyscale_Climbing;
  18: LET_L410_Greyscale_Flight;
  21: LET_L410_Greyscale_Landing;
  22: LET_L410_Greyscale_Touchdown;
      LET_L410_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, LET_L410_AirFrance, flight_state())
{
  15: LET_L410_AirFrance_Climbing;
  18: LET_L410_AirFrance_Flight;
  21: LET_L410_AirFrance_Landing;
  22: LET_L410_AirFrance_Touchdown;
      LET_L410_AirFrance_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, LET_L410_CSA, flight_state())
{
  15: LET_L410_CSA_Climbing;
  18: LET_L410_CSA_Flight;
  21: LET_L410_CSA_Landing;
  22: LET_L410_CSA_Touchdown;
      LET_L410_CSA_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, LET_L410_Satena, flight_state())
{
  15: LET_L410_Satena_Climbing;
  18: LET_L410_Satena_Flight;
  21: LET_L410_Satena_Landing;
  22: LET_L410_Satena_Touchdown;
      LET_L410_Satena_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, LET_L410_sprites, cargo_subtype)
{
  1: LET_L410_AirFrance;
  2: LET_L410_CSA;
  3: LET_L410_Satena;
     LET_L410_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, LET_L410_running_cost_factor, flight_state())
{
  plane_RC(38)
}

switch (FEAT_AIRCRAFT, SELF, LET_L410_speed, flight_state())
{
  // [speed-constant] 巡航速度恒定，不随飞行状态变化。
  // OpenTTD 将速度属性回调（CB36）的结果缓存于 cached_max_speed，仅在载具
  // 创建、机场状态切换和读档时刷新；按 flight_state 返回不同速度会让缓存
  // 卡在旧值上（起飞后停在跑道速度；读档后跑道速度变成巡航速度）。
  // 滑行/进近/刹车减速由游戏原生状态机按巡航速度自动派生，无需在此压低。
  return plane_speed_kmh(405); // cruise, keep in sync with purchase_speed
}

switch (FEAT_AIRCRAFT, SELF, LET_L410_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, LET_L410_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_LET_L410);
  1: string(STR_VLIV_AIR_FRANCE);
  2: string(STR_VLIV_CZECH_AIRLINES);
  3: string(STR_VLIV_SATENA);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, LET_L410_cargo_subtype_capacity, cargo_subtype)
{
  1: return 19;
  2: return 19;
  3: return 19;
     return 19;
}

item (FEAT_AIRCRAFT, LET_L410)
{
  property
  {
    name: string(STR_AIRV_LET_L410);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1971), 1, 1);
    vehicle_life: 11;
    model_life: get_model_life(1995,2020);
    retire_early: get_retire_early(1995,2020);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 17;
    passenger_capacity: 19;
    mail_capacity: 2;
    acceleration: 27;
    range: 273;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: LET_L410_sprites;
    purchase: LET_L410_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: LET_L410_cargo_subtype_text;
    passenger_capacity: LET_L410_cargo_subtype_capacity;
    speed: LET_L410_speed;
    running_cost_factor: LET_L410_running_cost_factor;
    sound_effect: LET_L410_sound_effect;

    cost_factor: 14;
    purchase_running_cost_factor: 38;
    purchase_speed: plane_speed_kmh(405);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, LET_L410)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, LET_L410)
  {
    property
    { range: 273; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, LET_L410)
  {
    property
    { range: 410; }
  }
}
