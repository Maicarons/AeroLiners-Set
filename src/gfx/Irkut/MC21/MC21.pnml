IRKUT_MC21_sprite_layout_template(IRKUT_MC21_AirArabia)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A320/A320-200/AirAsia.png"
IRKUT_MC21_sprite_layout_template(IRKUT_MC21_AirAsia)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, IRKUT_MC21_Greyscale, flight_state())
{
  15: IRKUT_MC21_Greyscale_Climbing;
  18: IRKUT_MC21_Greyscale_Flight;
  21: IRKUT_MC21_Greyscale_Landing;
  22: IRKUT_MC21_Greyscale_Touchdown;
      IRKUT_MC21_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, IRKUT_MC21_Aegan, flight_state())
{
  15: IRKUT_MC21_Aegan_Climbing;
  18: IRKUT_MC21_Aegan_Flight;
  21: IRKUT_MC21_Aegan_Landing;
  22: IRKUT_MC21_Aegan_Touchdown;
      IRKUT_MC21_Aegan_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, IRKUT_MC21_AerLingus, flight_state())
{
  15: IRKUT_MC21_AerLingus_Climbing;
  18: IRKUT_MC21_AerLingus_Flight;
  21: IRKUT_MC21_AerLingus_Landing;
  22: IRKUT_MC21_AerLingus_Touchdown;
      IRKUT_MC21_AerLingus_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, IRKUT_MC21_Aeroflot, flight_state())
{
  15: IRKUT_MC21_Aeroflot_Climbing;
  18: IRKUT_MC21_Aeroflot_Flight;
  21: IRKUT_MC21_Aeroflot_Landing;
  22: IRKUT_MC21_Aeroflot_Touchdown;
      IRKUT_MC21_Aeroflot_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, IRKUT_MC21_AirArabia, flight_state())
{
  15: IRKUT_MC21_AirArabia_Climbing;
  18: IRKUT_MC21_AirArabia_Flight;
  21: IRKUT_MC21_AirArabia_Landing;
  22: IRKUT_MC21_AirArabia_Touchdown;
      IRKUT_MC21_AirArabia_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, IRKUT_MC21_AirAsia, flight_state())
{
  15: IRKUT_MC21_AirAsia_Climbing;
  18: IRKUT_MC21_AirAsia_Flight;
  21: IRKUT_MC21_AirAsia_Landing;
  22: IRKUT_MC21_AirAsia_Touchdown;
      IRKUT_MC21_AirAsia_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, IRKUT_MC21_sprites, cargo_subtype)
{
  1: IRKUT_MC21_Aegan;
  2: IRKUT_MC21_AerLingus;
  3: IRKUT_MC21_Aeroflot;
  4: IRKUT_MC21_AirArabia;
  5: IRKUT_MC21_AirAsia;
     IRKUT_MC21_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, IRKUT_MC21_running_cost_factor, flight_state())
{
  plane_RC(77)
}

switch (FEAT_AIRCRAFT, SELF, IRKUT_MC21_speed, flight_state())
{
  // [speed-constant] 巡航速度恒定，不随飞行状态变化。
  // OpenTTD 将速度属性回调（CB36）的结果缓存于 cached_max_speed，仅在载具
  // 创建、机场状态切换和读档时刷新；按 flight_state 返回不同速度会让缓存
  // 卡在旧值上（起飞后停在跑道速度；读档后跑道速度变成巡航速度）。
  // 滑行/进近/刹车减速由游戏原生状态机按巡航速度自动派生，无需在此压低。
  return plane_speed_kmh(870); // cruise, keep in sync with purchase_speed
}

switch (FEAT_AIRCRAFT, SELF, IRKUT_MC21_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, IRKUT_MC21_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_IRKUT_MC21);
  1: string(STR_VLIV_AEGEAN_AIRLINES);
  2: string(STR_VLIV_AER_LINGUS);
  3: string(STR_VLIV_AEROFLOT);
  4: string(STR_VLIV_AIR_ARABIA);
  5: string(STR_VLIV_AIR_ASIA);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, IRKUT_MC21_cargo_subtype_capacity, cargo_subtype)
{
  1: return 180;
  2: return 180;
  3: return 180;
  4: return 180;
  5: return 180;
     return 180;
}

item (FEAT_AIRCRAFT, IRKUT_MC21)
{
  property
  {
    name: string(STR_AIRV_IRKUT_MC21);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2024), 1, 1);
    vehicle_life: 18;
    model_life: get_model_life(1989,2050);
    retire_early: get_retire_early(1989,2050);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 22;
    passenger_capacity: 163;
    mail_capacity: 18;
    acceleration: 27;
    range: 1091;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: IRKUT_MC21_sprites;
    purchase: IRKUT_MC21_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: IRKUT_MC21_cargo_subtype_text;
    passenger_capacity: IRKUT_MC21_cargo_subtype_capacity;
    speed: IRKUT_MC21_speed;
    running_cost_factor: IRKUT_MC21_running_cost_factor;
    sound_effect: IRKUT_MC21_sound_effect;

    cost_factor: 73;
    purchase_running_cost_factor: 77;
    purchase_speed: plane_speed_kmh(870);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, IRKUT_MC21)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, IRKUT_MC21)
  {
    property
    { range: 1091; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, IRKUT_MC21)
  {
    property
    { range: 1642; }
  }
}
