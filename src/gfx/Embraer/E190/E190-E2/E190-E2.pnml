// 灰阶基底（占位复用 Embraer_E190STD 灰阶图）
#define IMAGEFILE  "src/gfx/Embraer/E190/E190STD/(0)Greyscale.png"
purchase_sprite(EMBRAER_E190_E2, 255, 1, 45, 21, -23, -11)
EMBRAER_E190_E2_sprite_layout_template(EMBRAER_E190_E2_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Embraer/E190/E190STD/Alitalia.png"
EMBRAER_E190_E2_sprite_layout_template(EMBRAER_E190_E2_Alitalia)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Embraer/E190/E190STD/BACityflyer.png"
EMBRAER_E190_E2_sprite_layout_template(EMBRAER_E190_E2_BACityflyer)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Embraer/E190/E190STD/BulgariaAir.png"
EMBRAER_E190_E2_sprite_layout_template(EMBRAER_E190_E2_BulgariaAir)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Embraer/E190/E190STD/HOP.png"
EMBRAER_E190_E2_sprite_layout_template(EMBRAER_E190_E2_HOP)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Embraer/E190/E190STD/KLMCityhopper.png"
EMBRAER_E190_E2_sprite_layout_template(EMBRAER_E190_E2_KLMCityhopper)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E190_E2_Greyscale, flight_state())
{
  15: EMBRAER_E190_E2_Greyscale_Climbing;
  18: EMBRAER_E190_E2_Greyscale_Flight;
  21: EMBRAER_E190_E2_Greyscale_Landing;
  22: EMBRAER_E190_E2_Greyscale_Touchdown;
      EMBRAER_E190_E2_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E190_E2_Alitalia, flight_state())
{
  15: EMBRAER_E190_E2_Alitalia_Climbing;
  18: EMBRAER_E190_E2_Alitalia_Flight;
  21: EMBRAER_E190_E2_Alitalia_Landing;
  22: EMBRAER_E190_E2_Alitalia_Touchdown;
      EMBRAER_E190_E2_Alitalia_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E190_E2_BACityflyer, flight_state())
{
  15: EMBRAER_E190_E2_BACityflyer_Climbing;
  18: EMBRAER_E190_E2_BACityflyer_Flight;
  21: EMBRAER_E190_E2_BACityflyer_Landing;
  22: EMBRAER_E190_E2_BACityflyer_Touchdown;
      EMBRAER_E190_E2_BACityflyer_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E190_E2_BulgariaAir, flight_state())
{
  15: EMBRAER_E190_E2_BulgariaAir_Climbing;
  18: EMBRAER_E190_E2_BulgariaAir_Flight;
  21: EMBRAER_E190_E2_BulgariaAir_Landing;
  22: EMBRAER_E190_E2_BulgariaAir_Touchdown;
      EMBRAER_E190_E2_BulgariaAir_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E190_E2_HOP, flight_state())
{
  15: EMBRAER_E190_E2_HOP_Climbing;
  18: EMBRAER_E190_E2_HOP_Flight;
  21: EMBRAER_E190_E2_HOP_Landing;
  22: EMBRAER_E190_E2_HOP_Touchdown;
      EMBRAER_E190_E2_HOP_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E190_E2_KLMCityhopper, flight_state())
{
  15: EMBRAER_E190_E2_KLMCityhopper_Climbing;
  18: EMBRAER_E190_E2_KLMCityhopper_Flight;
  21: EMBRAER_E190_E2_KLMCityhopper_Landing;
  22: EMBRAER_E190_E2_KLMCityhopper_Touchdown;
      EMBRAER_E190_E2_KLMCityhopper_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E190_E2_sprites, cargo_subtype)
{
  1: EMBRAER_E190_E2_Alitalia;
  2: EMBRAER_E190_E2_BACityflyer;
  3: EMBRAER_E190_E2_BulgariaAir;
  4: EMBRAER_E190_E2_HOP;
  5: EMBRAER_E190_E2_KLMCityhopper;
     EMBRAER_E190_E2_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E190_E2_running_cost_factor, flight_state())
{
  plane_RC(29)
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E190_E2_speed, flight_state())
{
  12..13: return plane_speed_kmh(241); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(410); // airplane climbing after take-off
      18: return plane_speed_kmh(833); // heading for tower contact point
  16..20: return plane_speed_kmh(427); // in flight
  21..22: return plane_speed_kmh(273); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E190_E2_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E190_E2_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_EMBRAER_E190_E2);
  1: string(STR_VLIV_ALITALIA);
  2: string(STR_VLIV_BRITISH_AIRWAYS_UNION_FLAG);
  3: string(STR_VLIV_BULGARIA_AIR);
  4: string(STR_VLIV_HOP);
  5: string(STR_VLIV_KLM_CITYHOPPER);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E190_E2_cargo_subtype_capacity, cargo_subtype)
{
  1: return 97;
  2: return 97;
  3: return 97;
  4: return 97;
  5: return 97;
     return 97;
}

item (FEAT_AIRCRAFT, EMBRAER_E190_E2)
{
  property
  {
    name: string(STR_AIRV_EMBRAER_E190_E2);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2018), 1, 1);
    vehicle_life: 30;
    model_life: get_model_life(2004,2259);
    retire_early: get_retire_early(2004,2259);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 19;
    passenger_capacity: 97;
    mail_capacity: 10;
    acceleration: 27;
    range: 993;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: EMBRAER_E190_E2_sprites;
    purchase: EMBRAER_E190_E2_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: EMBRAER_E190_E2_cargo_subtype_text;
    passenger_capacity: EMBRAER_E190_E2_cargo_subtype_capacity;
    speed: EMBRAER_E190_E2_speed;
    running_cost_factor: EMBRAER_E190_E2_running_cost_factor;
    sound_effect: EMBRAER_E190_E2_sound_effect;

    cost_factor: 65;
    purchase_running_cost_factor: 29;
    purchase_speed: plane_speed_kmh(833);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, EMBRAER_E190_E2)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, EMBRAER_E190_E2)
  {
    property
    { range: 993; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, EMBRAER_E190_E2)
  {
    property
    { range: 1489; }
  }
}
