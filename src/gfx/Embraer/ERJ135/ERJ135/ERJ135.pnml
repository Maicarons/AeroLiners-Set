  [290, 90, 33, 16, -17, -8 , ANIM]                                          \
}                                                                            \
spriteset (name##_Landing, IMAGEFILE)                                        \
{                                                                            \
  [  1, 120, 30, 23, -15, -12, ANIM]                                         \
  [ 35, 120, 35, 20, -18, -10, ANIM]                                         \
  [ 75, 120, 43, 16, -22, -8 , ANIM]                                         \
  [125, 120, 34, 17, -17, -9 , ANIM]                                         \
  [165, 120, 30, 21, -15, -11, ANIM]                                         \
