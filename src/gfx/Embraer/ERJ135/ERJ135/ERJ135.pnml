// 灰阶基底（占位复用 Embraer_ERJ145 灰阶图）
#define IMAGEFILE  "src/gfx/Embraer/E145/ERJ145/(0)Greyscale.png"
purchase_sprite(EMBRAER_ERJ135, 240, 1, 43, 16, -22, -8)
EMBRAER_ERJ135_sprite_layout_template(EMBRAER_ERJ135_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Embraer/E145/ERJ145/HOP.png"
EMBRAER_ERJ135_sprite_layout_template(EMBRAER_ERJ135_HOP)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Embraer/E145/ERJ145/Lagunair.png"
EMBRAER_ERJ135_sprite_layout_template(EMBRAER_ERJ135_Lagunair)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, EMBRAER_ERJ135_Greyscale, flight_state())
{
  15: EMBRAER_ERJ135_Greyscale_Climbing;
  18: EMBRAER_ERJ135_Greyscale_Flight;
  21: EMBRAER_ERJ135_Greyscale_Landing;
  22: EMBRAER_ERJ135_Greyscale_Touchdown;
      EMBRAER_ERJ135_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_ERJ135_HOP, flight_state())
{
  15: EMBRAER_ERJ135_HOP_Climbing;
  18: EMBRAER_ERJ135_HOP_Flight;
  21: EMBRAER_ERJ135_HOP_Landing;
  22: EMBRAER_ERJ135_HOP_Touchdown;
      EMBRAER_ERJ135_HOP_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_ERJ135_Lagunair, flight_state())
{
  15: EMBRAER_ERJ135_Lagunair_Climbing;
  18: EMBRAER_ERJ135_Lagunair_Flight;
  21: EMBRAER_ERJ135_Lagunair_Landing;
  22: EMBRAER_ERJ135_Lagunair_Touchdown;
      EMBRAER_ERJ135_Lagunair_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_ERJ135_sprites, cargo_subtype)
{
  1: EMBRAER_ERJ135_HOP;
  2: EMBRAER_ERJ135_Lagunair;
     EMBRAER_ERJ135_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_ERJ135_running_cost_factor, flight_state())
{
  plane_RC(74)
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_ERJ135_speed, flight_state())
{
  12..13: return plane_speed_kmh(242); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(391); // airplane climbing after take-off
      18: return plane_speed_kmh(834); // heading for tower contact point
  16..20: return plane_speed_kmh(380); // in flight
  21..22: return plane_speed_kmh(236); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(202);
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_ERJ135_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_ERJ135_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_EMBRAER_ERJ135);
  1: string(STR_VLIV_HOP);
  2: string(STR_VLIV_LAGUNAIR);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_ERJ135_cargo_subtype_capacity, cargo_subtype)
{
  1: return 37;
  2: return 37;
     return 37;
}

item (FEAT_AIRCRAFT, EMBRAER_ERJ135)
{
  property
  {
    name: string(STR_AIRV_EMBRAER_ERJ135);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1999), 1, 1);
    vehicle_life: 18;
    model_life: get_model_life(1996,2020);
    retire_early: get_retire_early(1996,2020);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 17;
    passenger_capacity: 37;
    mail_capacity: 4;
    acceleration: 27;
    range: 591;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: EMBRAER_ERJ135_sprites;
    purchase: EMBRAER_ERJ135_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: EMBRAER_ERJ135_cargo_subtype_text;
    passenger_capacity: EMBRAER_ERJ135_cargo_subtype_capacity;
    speed: EMBRAER_ERJ135_speed;
    running_cost_factor: EMBRAER_ERJ135_running_cost_factor;
    sound_effect: EMBRAER_ERJ135_sound_effect;

    cost_factor: 14;
    purchase_running_cost_factor: 28;
    purchase_speed: plane_speed_kmh(834);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, EMBRAER_ERJ135)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, EMBRAER_ERJ135)
  {
    property
    { range: 591; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, EMBRAER_ERJ135)
  {
    property
    { range: 889; }
  }
}
