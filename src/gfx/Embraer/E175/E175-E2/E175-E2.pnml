  [ 40, 120, 31, 20, -16, -10, ANIM]                                         \
  [ 75, 120, 39, 21, -20, -11, ANIM]                                         \
  [120, 120, 32, 20, -16, -10, ANIM]                                         \
  [155, 120, 31, 20, -16, -10, ANIM]                                         \
  [190, 120, 32, 20, -16, -10, ANIM]                                         \
