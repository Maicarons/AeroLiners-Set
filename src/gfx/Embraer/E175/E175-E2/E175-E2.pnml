// 灰阶基底（占位复用 Embraer_E175STD 灰阶图）
#define IMAGEFILE  "src/gfx/Embraer/E175/E175STD/(0)Greyscale.png"
purchase_sprite(EMBRAER_E175_E2, 225, 1, 41, 19, -21, -10)
EMBRAER_E175_E2_sprite_layout_template(EMBRAER_E175_E2_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Embraer/E175/E175STD/AlitaliaCityliner.png"
EMBRAER_E175_E2_sprite_layout_template(EMBRAER_E175_E2_AlitaliaCityliner)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Embraer/E175/E175STD/Flybe.png"
EMBRAER_E175_E2_sprite_layout_template(EMBRAER_E175_E2_Flybe)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E175_E2_Greyscale, flight_state())
{
  15: EMBRAER_E175_E2_Greyscale_Climbing;
  18: EMBRAER_E175_E2_Greyscale_Flight;
  21: EMBRAER_E175_E2_Greyscale_Landing;
  22: EMBRAER_E175_E2_Greyscale_Touchdown;
      EMBRAER_E175_E2_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E175_E2_AlitaliaCityliner, flight_state())
{
  15: EMBRAER_E175_E2_AlitaliaCityliner_Climbing;
  18: EMBRAER_E175_E2_AlitaliaCityliner_Flight;
  21: EMBRAER_E175_E2_AlitaliaCityliner_Landing;
  22: EMBRAER_E175_E2_AlitaliaCityliner_Touchdown;
      EMBRAER_E175_E2_AlitaliaCityliner_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E175_E2_Flybe, flight_state())
{
  15: EMBRAER_E175_E2_Flybe_Climbing;
  18: EMBRAER_E175_E2_Flybe_Flight;
  21: EMBRAER_E175_E2_Flybe_Landing;
  22: EMBRAER_E175_E2_Flybe_Touchdown;
      EMBRAER_E175_E2_Flybe_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E175_E2_sprites, cargo_subtype)
{
  1: EMBRAER_E175_E2_AlitaliaCityliner;
  2: EMBRAER_E175_E2_Flybe;
     EMBRAER_E175_E2_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E175_E2_running_cost_factor, flight_state())
{
  plane_RC(44)
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E175_E2_speed, flight_state())
{
  12..13: return plane_speed_kmh(241); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(410); // airplane climbing after take-off
      18: return plane_speed_kmh(886); // heading for tower contact point
  16..20: return plane_speed_kmh(418); // in flight
  21..22: return plane_speed_kmh(257); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E175_E2_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E175_E2_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_EMBRAER_E175_E2);
  1: string(STR_VLIV_ALITALIA_CITY);
  2: string(STR_VLIV_FLYBE);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, EMBRAER_E175_E2_cargo_subtype_capacity, cargo_subtype)
{
  1: return 88;
  2: return 88;
     return 88;
}

item (FEAT_AIRCRAFT, EMBRAER_E175_E2)
{
  property
  {
    name: string(STR_AIRV_EMBRAER_E175_E2);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2027), 1, 1);
    vehicle_life: 30;
    model_life: get_model_life(2005,2259);
    retire_early: get_retire_early(2005,2259);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 28;
    passenger_capacity: 88;
    mail_capacity: 9;
    acceleration: 27;
    range: 673;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: EMBRAER_E175_E2_sprites;
    purchase: EMBRAER_E175_E2_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: EMBRAER_E175_E2_cargo_subtype_text;
    passenger_capacity: EMBRAER_E175_E2_cargo_subtype_capacity;
    speed: EMBRAER_E175_E2_speed;
    running_cost_factor: EMBRAER_E175_E2_running_cost_factor;
    sound_effect: EMBRAER_E175_E2_sound_effect;

    cost_factor: 26;
    purchase_running_cost_factor: 44;
    purchase_speed: plane_speed_kmh(886);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, EMBRAER_E175_E2)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, EMBRAER_E175_E2)
  {
    property
    { range: 673; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, EMBRAER_E175_E2)
  {
    property
    { range: 1009; }
  }
}
