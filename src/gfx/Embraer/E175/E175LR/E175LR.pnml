switch (FEAT_AIRCRAFT, SELF, Embraer_E175LR_Greyscale, flight_state())
{
  15: Embraer_E175LR_Greyscale_Climbing;
  18: Embraer_E175LR_Greyscale_Flight;
  21: Embraer_E175LR_Greyscale_Landing;
  22: Embraer_E175LR_Greyscale_Touchdown;
      Embraer_E175LR_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, Embraer_E175LR_Belavia, flight_state())
{
  15: Embraer_E175LR_Belavia_Climbing;
  18: Embraer_E175LR_Belavia_Flight;
  21: Embraer_E175LR_Belavia_Landing;
  22: Embraer_E175LR_Belavia_Touchdown;
      Embraer_E175LR_Belavia_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, Embraer_E175LR_RoyalJordanian, flight_state())
{
  15: Embraer_E175LR_RoyalJordanian_Climbing;
  18: Embraer_E175LR_RoyalJordanian_Flight;
  21: Embraer_E175LR_RoyalJordanian_Landing;
  22: Embraer_E175LR_RoyalJordanian_Touchdown;
      Embraer_E175LR_RoyalJordanian_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, Embraer_E175LR_sprites, cargo_subtype)
{
  1: Embraer_E175LR_Belavia;
  2: Embraer_E175LR_RoyalJordanian;
  	 Embraer_E175LR_Greyscale;
}  
                             
switch (FEAT_AIRCRAFT, SELF, Embraer_E175LR_running_cost_factor, flight_state())
{
  plane_RC(44)
}

switch (FEAT_AIRCRAFT, SELF, Embraer_E175LR_speed, flight_state())
{
  // [speed-constant] 巡航速度恒定，不随飞行状态变化。
  // OpenTTD 将速度属性回调（CB36）的结果缓存于 cached_max_speed，仅在载具
  // 创建、机场状态切换和读档时刷新；按 flight_state 返回不同速度会让缓存
  // 卡在旧值上（起飞后停在跑道速度；读档后跑道速度变成巡航速度）。
  // 滑行/进近/刹车减速由游戏原生状态机按巡航速度自动派生，无需在此压低。
  return plane_speed_kmh(829); // cruise, keep in sync with purchase_speed
}

switch (FEAT_AIRCRAFT, SELF, Embraer_E175LR_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_EMBRAER);
  1: string(STR_VLIV_BELAVIA);
  2: string(STR_VLIV_ROYAL_JORDANIAN);
       return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, Embraer_E175LR_cargo_subtype_capacity, cargo_subtype)
{
  1: return 76; // Belavia
  2: return 72; // Royal Jordanian
     return 86;
}

item (FEAT_AIRCRAFT, Embraer_E175LR)
{
  property
  {
    name: string(STR_AIRV_EMBRAER_ERJ_175LR);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2005), 7, 1);
    vehicle_life: 30;
    model_life: get_model_life(2005,2259);
    retire_early: get_retire_early(2005,2259);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 28;
    passenger_capacity: 76;
    mail_capacity: 9;
    acceleration: 27;                  // in 27,75 mph/day
    range: 741;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: Embraer_E175LR_sprites;
    purchase: Embraer_E175LR_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: Embraer_E175LR_cargo_subtype_text;
	passenger_capacity: Embraer_E175LR_cargo_subtype_capacity;
    speed: Embraer_E175LR_speed;
    running_cost_factor: Embraer_E175LR_running_cost_factor;

    cost_factor: 27; 
    purchase_running_cost_factor: 41;
    purchase_speed: plane_speed_kmh(829); 
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, Embraer_E175LR)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, Embraer_E175LR)
  {
    property
    { range: 741; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, Embraer_E175LR)
  {
    property
    { range: 1112; }
  }
}
