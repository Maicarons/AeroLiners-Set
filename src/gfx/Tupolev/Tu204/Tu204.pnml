// 灰阶基底（占位复用 Boeing_757_200 灰阶图）
#define IMAGEFILE  "src/gfx/Boeing/B757/B757-200/(0)Greyscale.png"
purchase_sprite(TUPOLEV_TU204, 295, 40, 50, 24, -25, -12)
TUPOLEV_TU204_sprite_layout_template(TUPOLEV_TU204_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B757/B757-200/AerLingus.png"
TUPOLEV_TU204_sprite_layout_template(TUPOLEV_TU204_AerLingus)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B757/B757-200/AirBaltic.png"
TUPOLEV_TU204_sprite_layout_template(TUPOLEV_TU204_AirBaltic)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B757/B757-200/AirBerlin.png"
