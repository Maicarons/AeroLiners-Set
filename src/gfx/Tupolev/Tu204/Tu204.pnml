#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B757/B757-200/AirGreenland.png"
TUPOLEV_TU204_sprite_layout_template(TUPOLEV_TU204_AirGreenland)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, TUPOLEV_TU204_Greyscale, flight_state())
{
  15: TUPOLEV_TU204_Greyscale_Climbing;
  18: TUPOLEV_TU204_Greyscale_Flight;
  21: TUPOLEV_TU204_Greyscale_Landing;
  22: TUPOLEV_TU204_Greyscale_Touchdown;
      TUPOLEV_TU204_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, TUPOLEV_TU204_AerLingus, flight_state())
{
  15: TUPOLEV_TU204_AerLingus_Climbing;
  18: TUPOLEV_TU204_AerLingus_Flight;
  21: TUPOLEV_TU204_AerLingus_Landing;
  22: TUPOLEV_TU204_AerLingus_Touchdown;
      TUPOLEV_TU204_AerLingus_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, TUPOLEV_TU204_AirBaltic, flight_state())
{
  15: TUPOLEV_TU204_AirBaltic_Climbing;
  18: TUPOLEV_TU204_AirBaltic_Flight;
  21: TUPOLEV_TU204_AirBaltic_Landing;
  22: TUPOLEV_TU204_AirBaltic_Touchdown;
      TUPOLEV_TU204_AirBaltic_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, TUPOLEV_TU204_AirBerlin, flight_state())
{
  15: TUPOLEV_TU204_AirBerlin_Climbing;
  18: TUPOLEV_TU204_AirBerlin_Flight;
  21: TUPOLEV_TU204_AirBerlin_Landing;
  22: TUPOLEV_TU204_AirBerlin_Touchdown;
      TUPOLEV_TU204_AirBerlin_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, TUPOLEV_TU204_AirEuropa, flight_state())
{
  15: TUPOLEV_TU204_AirEuropa_Climbing;
  18: TUPOLEV_TU204_AirEuropa_Flight;
  21: TUPOLEV_TU204_AirEuropa_Landing;
  22: TUPOLEV_TU204_AirEuropa_Touchdown;
      TUPOLEV_TU204_AirEuropa_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, TUPOLEV_TU204_AirGreenland, flight_state())
{
  15: TUPOLEV_TU204_AirGreenland_Climbing;
  18: TUPOLEV_TU204_AirGreenland_Flight;
  21: TUPOLEV_TU204_AirGreenland_Landing;
  22: TUPOLEV_TU204_AirGreenland_Touchdown;
      TUPOLEV_TU204_AirGreenland_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, TUPOLEV_TU204_sprites, cargo_subtype)
{
  1: TUPOLEV_TU204_AerLingus;
  2: TUPOLEV_TU204_AirBaltic;
  3: TUPOLEV_TU204_AirBerlin;
  4: TUPOLEV_TU204_AirEuropa;
  5: TUPOLEV_TU204_AirGreenland;
     TUPOLEV_TU204_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, TUPOLEV_TU204_running_cost_factor, flight_state())
{
  plane_RC(93)
}

switch (FEAT_AIRCRAFT, SELF, TUPOLEV_TU204_speed, flight_state())
{
  // [speed-constant] 巡航速度恒定，不随飞行状态变化。
  // OpenTTD 将速度属性回调（CB36）的结果缓存于 cached_max_speed，仅在载具
  // 创建、机场状态切换和读档时刷新；按 flight_state 返回不同速度会让缓存
  // 卡在旧值上（起飞后停在跑道速度；读档后跑道速度变成巡航速度）。
  // 滑行/进近/刹车减速由游戏原生状态机按巡航速度自动派生，无需在此压低。
  return plane_speed_kmh(850); // cruise, keep in sync with purchase_speed
}

switch (FEAT_AIRCRAFT, SELF, TUPOLEV_TU204_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, TUPOLEV_TU204_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_TUPOLEV_TU204);
  1: string(STR_VLIV_AER_LINGUS);
  2: string(STR_VLIV_AIR_BALTIC);
  3: string(STR_VLIV_AIR_BERLIN);
  4: string(STR_VLIV_AIR_EUROPA);
  5: string(STR_VLIV_AIR_GREENLAND);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, TUPOLEV_TU204_cargo_subtype_capacity, cargo_subtype)
{
  1: return 190;
  2: return 190;
  3: return 190;
  4: return 190;
  5: return 190;
     return 190;
}

item (FEAT_AIRCRAFT, TUPOLEV_TU204)
{
  property
  {
    name: string(STR_AIRV_TUPOLEV_TU204);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1992), 1, 1);
    vehicle_life: 25;
    model_life: get_model_life(1983,2004);
    retire_early: get_retire_early(1983,2004);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 23;
    passenger_capacity: 190;
    mail_capacity: 19;
    acceleration: 27;
    range: 782;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: TUPOLEV_TU204_sprites;
    purchase: TUPOLEV_TU204_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: TUPOLEV_TU204_cargo_subtype_text;
    passenger_capacity: TUPOLEV_TU204_cargo_subtype_capacity;
    speed: TUPOLEV_TU204_speed;
    running_cost_factor: TUPOLEV_TU204_running_cost_factor;
    sound_effect: TUPOLEV_TU204_sound_effect;

    cost_factor: 79;
    purchase_running_cost_factor: 93;
    purchase_speed: plane_speed_kmh(850);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, TUPOLEV_TU204)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, TUPOLEV_TU204)
  {
    property
    { range: 782; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, TUPOLEV_TU204)
  {
    property
    { range: 1174; }
  }
}
