// 灰阶基底（占位复用 ATR_72_500 灰阶图）
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/(0)Greyscale.png"
purchase_sprite(LOCKHEED_L188, 283, 1, 50, 23, -25, -12)
LOCKHEED_L188_sprite_layout_template(LOCKHEED_L188_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AerArran.png"
LOCKHEED_L188_sprite_layout_template(LOCKHEED_L188_AerArran)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AirDeccan.png"
LOCKHEED_L188_sprite_layout_template(LOCKHEED_L188_AirDeccan)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AirDolomiti.png"
LOCKHEED_L188_sprite_layout_template(LOCKHEED_L188_AirDolomiti)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/Airlinair.png"
LOCKHEED_L188_sprite_layout_template(LOCKHEED_L188_Airlinair)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AirNostrum.png"
LOCKHEED_L188_sprite_layout_template(LOCKHEED_L188_AirNostrum)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, LOCKHEED_L188_Greyscale, flight_state())
{
  15: LOCKHEED_L188_Greyscale_Climbing;
  18: LOCKHEED_L188_Greyscale_Flight;
  21: LOCKHEED_L188_Greyscale_Landing;
  22: LOCKHEED_L188_Greyscale_Touchdown;
      LOCKHEED_L188_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, LOCKHEED_L188_AerArran, flight_state())
{
  15: LOCKHEED_L188_AerArran_Climbing;
  18: LOCKHEED_L188_AerArran_Flight;
  21: LOCKHEED_L188_AerArran_Landing;
  22: LOCKHEED_L188_AerArran_Touchdown;
      LOCKHEED_L188_AerArran_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, LOCKHEED_L188_AirDeccan, flight_state())
{
  15: LOCKHEED_L188_AirDeccan_Climbing;
  18: LOCKHEED_L188_AirDeccan_Flight;
  21: LOCKHEED_L188_AirDeccan_Landing;
  22: LOCKHEED_L188_AirDeccan_Touchdown;
      LOCKHEED_L188_AirDeccan_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, LOCKHEED_L188_AirDolomiti, flight_state())
{
  15: LOCKHEED_L188_AirDolomiti_Climbing;
  18: LOCKHEED_L188_AirDolomiti_Flight;
  21: LOCKHEED_L188_AirDolomiti_Landing;
  22: LOCKHEED_L188_AirDolomiti_Touchdown;
      LOCKHEED_L188_AirDolomiti_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, LOCKHEED_L188_Airlinair, flight_state())
{
  15: LOCKHEED_L188_Airlinair_Climbing;
  18: LOCKHEED_L188_Airlinair_Flight;
  21: LOCKHEED_L188_Airlinair_Landing;
  22: LOCKHEED_L188_Airlinair_Touchdown;
      LOCKHEED_L188_Airlinair_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, LOCKHEED_L188_AirNostrum, flight_state())
{
  15: LOCKHEED_L188_AirNostrum_Climbing;
  18: LOCKHEED_L188_AirNostrum_Flight;
  21: LOCKHEED_L188_AirNostrum_Landing;
  22: LOCKHEED_L188_AirNostrum_Touchdown;
      LOCKHEED_L188_AirNostrum_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, LOCKHEED_L188_sprites, cargo_subtype)
{
  1: LOCKHEED_L188_AerArran;
  2: LOCKHEED_L188_AirDeccan;
  3: LOCKHEED_L188_AirDolomiti;
  4: LOCKHEED_L188_Airlinair;
  5: LOCKHEED_L188_AirNostrum;
     LOCKHEED_L188_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, LOCKHEED_L188_running_cost_factor, flight_state())
{
  plane_RC(39)
}

switch (FEAT_AIRCRAFT, SELF, LOCKHEED_L188_speed, flight_state())
{
  12..13: return plane_speed_kmh(257); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(346); // airplane climbing after take-off
      18: return plane_speed_kmh(515); // heading for tower contact point
  16..20: return plane_speed_kmh(378); // in flight
  21..22: return plane_speed_kmh(217); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

switch (FEAT_AIRCRAFT, SELF, LOCKHEED_L188_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, LOCKHEED_L188_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_LOCKHEED_L188);
  1: string(STR_VLIV_AER_ARRAN_RINGED_DESIGN);
  2: string(STR_VLIV_AIR_DECCAN);
  3: string(STR_VLIV_AIR_DOLOMITI);
  4: string(STR_VLIV_AIRLINAIR_AIR_FRANCE);
  5: string(STR_VLIV_AIR_NOSTRUM_IBERIA_REGIONAL);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, LOCKHEED_L188_cargo_subtype_capacity, cargo_subtype)
{
  1: return 100;
  2: return 100;
  3: return 100;
  4: return 100;
  5: return 100;
     return 100;
}

item (FEAT_AIRCRAFT, LOCKHEED_L188)
{
  property
  {
    name: string(STR_AIRV_LOCKHEED_L188);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1959), 1, 1);
    vehicle_life: 11;
    model_life: get_model_life(1997,2024);
    retire_early: get_retire_early(1997,2024);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 16;
    passenger_capacity: 100;
    mail_capacity: 10;
    acceleration: 27;
    range: 727;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: LOCKHEED_L188_sprites;
    purchase: LOCKHEED_L188_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: LOCKHEED_L188_cargo_subtype_text;
    passenger_capacity: LOCKHEED_L188_cargo_subtype_capacity;
    speed: LOCKHEED_L188_speed;
    running_cost_factor: LOCKHEED_L188_running_cost_factor;
    sound_effect: LOCKHEED_L188_sound_effect;

    cost_factor: 18;
    purchase_running_cost_factor: 39;
    purchase_speed: plane_speed_kmh(515);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, LOCKHEED_L188)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, LOCKHEED_L188)
  {
    property
    { range: 727; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, LOCKHEED_L188)
  {
    property
    { range: 1097; }
  }
}
