{                                                                            \
  [  1, 1, 46, 22, -23, -11, ANIM]                                           \
  [ 52,	1, 38, 19, -19,	-10, ANIM]                                           \
  [ 95,	1, 46, 23, -23,	-12, ANIM]                                           \
  [146,	1, 39, 28, -20,	-14, ANIM]                                           \
  [190,	1, 46, 33, -23,	-17, ANIM]                                           \
  [241,	1, 39, 28, -20,	-14, ANIM]                                           \
  [285,	1, 46, 23, -23,	-12, ANIM]                                           \
  [336,	1, 38, 19, -19,	-10, ANIM]                                           \
}                                                                            \
