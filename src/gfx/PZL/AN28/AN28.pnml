// 灰阶基底（占位复用 ATR_42_500 灰阶图）

// 灰阶基底（占位复用 FOKKER_F27 灰阶图）
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/(0)Greyscale.png"
purchase_sprite(PZL_AN28, 285, 1, 46, 23, -23, -12)
PZL_AN28_sprite_layout_template(PZL_AN28_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/AirFrance.png"
PZL_AN28_sprite_layout_template(PZL_AN28_AirFrance)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/CSA.png"
PZL_AN28_sprite_layout_template(PZL_AN28_CSA)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/Satena.png"
PZL_AN28_sprite_layout_template(PZL_AN28_Satena)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, PZL_AN28_Greyscale, flight_state())
{
  15: PZL_AN28_Greyscale_Climbing;
  18: PZL_AN28_Greyscale_Flight;
  21: PZL_AN28_Greyscale_Landing;
  22: PZL_AN28_Greyscale_Touchdown;
      PZL_AN28_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, PZL_AN28_AirFrance, flight_state())
{
  15: PZL_AN28_AirFrance_Climbing;
  18: PZL_AN28_AirFrance_Flight;
  21: PZL_AN28_AirFrance_Landing;
  22: PZL_AN28_AirFrance_Touchdown;
      PZL_AN28_AirFrance_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, PZL_AN28_CSA, flight_state())
{
  15: PZL_AN28_CSA_Climbing;
  18: PZL_AN28_CSA_Flight;
  21: PZL_AN28_CSA_Landing;
  22: PZL_AN28_CSA_Touchdown;
      PZL_AN28_CSA_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, PZL_AN28_Satena, flight_state())
{
  15: PZL_AN28_Satena_Climbing;
  18: PZL_AN28_Satena_Flight;
  21: PZL_AN28_Satena_Landing;
  22: PZL_AN28_Satena_Touchdown;
      PZL_AN28_Satena_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, PZL_AN28_sprites, cargo_subtype)
{
  1: PZL_AN28_AirFrance;
  2: PZL_AN28_CSA;
  3: PZL_AN28_Satena;
     PZL_AN28_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, PZL_AN28_running_cost_factor, flight_state())
{
  plane_RC(38)
}

switch (FEAT_AIRCRAFT, SELF, PZL_AN28_speed, flight_state())
{
  12..13: return plane_speed_kmh(153); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(205); // airplane climbing after take-off
      18: return plane_speed_kmh(335); // heading for tower contact point
  16..20: return plane_speed_kmh(201); // in flight
  21..22: return plane_speed_kmh(124); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(120);
}

switch (FEAT_AIRCRAFT, SELF, PZL_AN28_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, PZL_AN28_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_PZL_AN28);
  1: string(STR_VLIV_AIR_FRANCE);
  2: string(STR_VLIV_CZECH_AIRLINES);
  3: string(STR_VLIV_SATENA);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, PZL_AN28_cargo_subtype_capacity, cargo_subtype)
{
  1: return 19;
  2: return 19;
  3: return 19;
     return 19;
}

item (FEAT_AIRCRAFT, PZL_AN28)
{
  property
  {
    name: string(STR_AIRV_PZL_AN28);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1975), 1, 1);
    vehicle_life: 11;
    model_life: get_model_life(1995,2020);
    retire_early: get_retire_early(1995,2020);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 17;
    passenger_capacity: 15;
    mail_capacity: 2;
    acceleration: 27;
    range: 248;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: PZL_AN28_sprites;
    purchase: PZL_AN28_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: PZL_AN28_cargo_subtype_text;
    passenger_capacity: PZL_AN28_cargo_subtype_capacity;
    speed: PZL_AN28_speed;
    running_cost_factor: PZL_AN28_running_cost_factor;
    sound_effect: PZL_AN28_sound_effect;

    cost_factor: 14;
    purchase_running_cost_factor: 38;
    purchase_speed: plane_speed_kmh(335);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, PZL_AN28)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, PZL_AN28)
  {
    property
    { range: 248; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, PZL_AN28)
  {
    property
    { range: 372; }
  }
}
