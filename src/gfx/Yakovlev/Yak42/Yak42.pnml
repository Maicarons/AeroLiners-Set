YAKOVLEV_YAK42_sprite_layout_template(YAKOVLEV_YAK42_AirFlorida)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B727/B727-200/AirFrance.png"
YAKOVLEV_YAK42_sprite_layout_template(YAKOVLEV_YAK42_AirFrance)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, YAKOVLEV_YAK42_Greyscale, flight_state())
{
  15: YAKOVLEV_YAK42_Greyscale_Climbing;
  18: YAKOVLEV_YAK42_Greyscale_Flight;
  21: YAKOVLEV_YAK42_Greyscale_Landing;
  22: YAKOVLEV_YAK42_Greyscale_Touchdown;
      YAKOVLEV_YAK42_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, YAKOVLEV_YAK42_Aerolineas, flight_state())
{
  15: YAKOVLEV_YAK42_Aerolineas_Climbing;
  18: YAKOVLEV_YAK42_Aerolineas_Flight;
  21: YAKOVLEV_YAK42_Aerolineas_Landing;
  22: YAKOVLEV_YAK42_Aerolineas_Touchdown;
      YAKOVLEV_YAK42_Aerolineas_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, YAKOVLEV_YAK42_AirAlgerie, flight_state())
{
  15: YAKOVLEV_YAK42_AirAlgerie_Climbing;
  18: YAKOVLEV_YAK42_AirAlgerie_Flight;
  21: YAKOVLEV_YAK42_AirAlgerie_Landing;
  22: YAKOVLEV_YAK42_AirAlgerie_Touchdown;
      YAKOVLEV_YAK42_AirAlgerie_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, YAKOVLEV_YAK42_AirCanada, flight_state())
{
  15: YAKOVLEV_YAK42_AirCanada_Climbing;
  18: YAKOVLEV_YAK42_AirCanada_Flight;
  21: YAKOVLEV_YAK42_AirCanada_Landing;
  22: YAKOVLEV_YAK42_AirCanada_Touchdown;
      YAKOVLEV_YAK42_AirCanada_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, YAKOVLEV_YAK42_AirFlorida, flight_state())
{
  15: YAKOVLEV_YAK42_AirFlorida_Climbing;
  18: YAKOVLEV_YAK42_AirFlorida_Flight;
  21: YAKOVLEV_YAK42_AirFlorida_Landing;
  22: YAKOVLEV_YAK42_AirFlorida_Touchdown;
      YAKOVLEV_YAK42_AirFlorida_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, YAKOVLEV_YAK42_AirFrance, flight_state())
{
  15: YAKOVLEV_YAK42_AirFrance_Climbing;
  18: YAKOVLEV_YAK42_AirFrance_Flight;
  21: YAKOVLEV_YAK42_AirFrance_Landing;
  22: YAKOVLEV_YAK42_AirFrance_Touchdown;
      YAKOVLEV_YAK42_AirFrance_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, YAKOVLEV_YAK42_sprites, cargo_subtype)
{
  1: YAKOVLEV_YAK42_Aerolineas;
  2: YAKOVLEV_YAK42_AirAlgerie;
  3: YAKOVLEV_YAK42_AirCanada;
  4: YAKOVLEV_YAK42_AirFlorida;
  5: YAKOVLEV_YAK42_AirFrance;
     YAKOVLEV_YAK42_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, YAKOVLEV_YAK42_running_cost_factor, flight_state())
{
  plane_RC(97)
}

switch (FEAT_AIRCRAFT, SELF, YAKOVLEV_YAK42_speed, flight_state())
{
  12..13: return plane_speed_kmh(214); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(381); // airplane climbing after take-off
      18: return plane_speed_kmh(740); // heading for tower contact point
  16..20: return plane_speed_kmh(340); // in flight
  21..22: return plane_speed_kmh(179); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(149);
}

switch (FEAT_AIRCRAFT, SELF, YAKOVLEV_YAK42_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, YAKOVLEV_YAK42_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_YAKOVLEV_YAK42);
  1: string(STR_VLIV_AEROLINEAS_ARGENTINAS);
  2: string(STR_VLIV_AIR_ALGERIE);
  3: string(STR_VLIV_AIR_CANADA);
  4: string(STR_VLIV_AIR_FLORIDA);
  5: string(STR_VLIV_AIR_FRANCE);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, YAKOVLEV_YAK42_cargo_subtype_capacity, cargo_subtype)
{
  1: return 120;
  2: return 120;
  3: return 120;
  4: return 120;
  5: return 120;
     return 120;
}

item (FEAT_AIRCRAFT, YAKOVLEV_YAK42)
{
  property
  {
    name: string(STR_AIRV_YAKOVLEV_YAK42);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1980), 1, 1);
    vehicle_life: 25;
    model_life: get_model_life(1967,1984);
    retire_early: get_retire_early(1967,1984);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 22;
    passenger_capacity: 120;
    mail_capacity: 16;
    acceleration: 27;
    range: 527;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: YAKOVLEV_YAK42_sprites;
    purchase: YAKOVLEV_YAK42_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: YAKOVLEV_YAK42_cargo_subtype_text;
    passenger_capacity: YAKOVLEV_YAK42_cargo_subtype_capacity;
    speed: YAKOVLEV_YAK42_speed;
    running_cost_factor: YAKOVLEV_YAK42_running_cost_factor;
    sound_effect: YAKOVLEV_YAK42_sound_effect;

    cost_factor: 30;
    purchase_running_cost_factor: 97;
    purchase_speed: plane_speed_kmh(740);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, YAKOVLEV_YAK42)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, YAKOVLEV_YAK42)
  {
    property
    { range: 527; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, YAKOVLEV_YAK42)
  {
    property
    { range: 789; }
  }
}
