// 灰阶基底（占位复用 Boeing_727_200 灰阶图）
#define IMAGEFILE  "src/gfx/Boeing/B727/B727-200/(0)Greyscale.png"
purchase_sprite(YAKOVLEV_YAK42, 300, 3, 55, 21, -28, -11)
YAKOVLEV_YAK42_sprite_layout_template(YAKOVLEV_YAK42_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B727/B727-200/Aerolineas.png"
YAKOVLEV_YAK42_sprite_layout_template(YAKOVLEV_YAK42_Aerolineas)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B727/B727-200/AirAlgerie.png"
YAKOVLEV_YAK42_sprite_layout_template(YAKOVLEV_YAK42_AirAlgerie)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B727/B727-200/AirCanada.png"
