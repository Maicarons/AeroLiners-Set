// 灰阶基底（占位复用 Boeing_757_200 灰阶图）
#define IMAGEFILE  "src/gfx/Boeing/B757/B757-200/(0)Greyscale.png"
purchase_sprite(BOEING_757_300, 295, 40, 50, 24, -25, -12)
BOEING_757_300_sprite_layout_template(BOEING_757_300_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B757/B757-200/AerLingus.png"
BOEING_757_300_sprite_layout_template(BOEING_757_300_AerLingus)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B757/B757-200/AirBaltic.png"
BOEING_757_300_sprite_layout_template(BOEING_757_300_AirBaltic)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B757/B757-200/AirBerlin.png"
BOEING_757_300_sprite_layout_template(BOEING_757_300_AirBerlin)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B757/B757-200/AirEuropa.png"
BOEING_757_300_sprite_layout_template(BOEING_757_300_AirEuropa)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B757/B757-200/AirGreenland.png"
BOEING_757_300_sprite_layout_template(BOEING_757_300_AirGreenland)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, BOEING_757_300_Greyscale, flight_state())
{
  15: BOEING_757_300_Greyscale_Climbing;
  18: BOEING_757_300_Greyscale_Flight;
  21: BOEING_757_300_Greyscale_Landing;
  22: BOEING_757_300_Greyscale_Touchdown;
      BOEING_757_300_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_757_300_AerLingus, flight_state())
{
  15: BOEING_757_300_AerLingus_Climbing;
  18: BOEING_757_300_AerLingus_Flight;
  21: BOEING_757_300_AerLingus_Landing;
  22: BOEING_757_300_AerLingus_Touchdown;
      BOEING_757_300_AerLingus_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_757_300_AirBaltic, flight_state())
{
  15: BOEING_757_300_AirBaltic_Climbing;
  18: BOEING_757_300_AirBaltic_Flight;
  21: BOEING_757_300_AirBaltic_Landing;
  22: BOEING_757_300_AirBaltic_Touchdown;
      BOEING_757_300_AirBaltic_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_757_300_AirBerlin, flight_state())
{
  15: BOEING_757_300_AirBerlin_Climbing;
  18: BOEING_757_300_AirBerlin_Flight;
  21: BOEING_757_300_AirBerlin_Landing;
  22: BOEING_757_300_AirBerlin_Touchdown;
      BOEING_757_300_AirBerlin_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_757_300_AirEuropa, flight_state())
{
  15: BOEING_757_300_AirEuropa_Climbing;
  18: BOEING_757_300_AirEuropa_Flight;
  21: BOEING_757_300_AirEuropa_Landing;
  22: BOEING_757_300_AirEuropa_Touchdown;
      BOEING_757_300_AirEuropa_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_757_300_AirGreenland, flight_state())
{
  15: BOEING_757_300_AirGreenland_Climbing;
  18: BOEING_757_300_AirGreenland_Flight;
  21: BOEING_757_300_AirGreenland_Landing;
  22: BOEING_757_300_AirGreenland_Touchdown;
      BOEING_757_300_AirGreenland_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_757_300_sprites, cargo_subtype)
{
  1: BOEING_757_300_AerLingus;
  2: BOEING_757_300_AirBaltic;
  3: BOEING_757_300_AirBerlin;
  4: BOEING_757_300_AirEuropa;
  5: BOEING_757_300_AirGreenland;
     BOEING_757_300_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_757_300_running_cost_factor, flight_state())
{
  plane_RC(93)
}

switch (FEAT_AIRCRAFT, SELF, BOEING_757_300_speed, flight_state())
{
  12..13: return plane_speed_kmh(233); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(402); // airplane climbing after take-off
      18: return plane_speed_kmh(934); // heading for tower contact point
  16..20: return plane_speed_kmh(443); // in flight
  21..22: return plane_speed_kmh(257); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

switch (FEAT_AIRCRAFT, SELF, BOEING_757_300_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_757_300_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_BOEING_757_300);
  1: string(STR_VLIV_AER_LINGUS);
  2: string(STR_VLIV_AIR_BALTIC);
  3: string(STR_VLIV_AIR_BERLIN);
  4: string(STR_VLIV_AIR_EUROPA);
  5: string(STR_VLIV_AIR_GREENLAND);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_757_300_cargo_subtype_capacity, cargo_subtype)
{
  1: return 243;
  2: return 243;
  3: return 243;
  4: return 243;
  5: return 243;
     return 243;
}

item (FEAT_AIRCRAFT, BOEING_757_300)
{
  property
  {
    name: string(STR_AIRV_BOEING_757_300);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1999), 1, 1);
    vehicle_life: 25;
    model_life: get_model_life(1983,2004);
    retire_early: get_retire_early(1983,2004);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 23;
    passenger_capacity: 243;
    mail_capacity: 24;
    acceleration: 27;
    range: 1273;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: BOEING_757_300_sprites;
    purchase: BOEING_757_300_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: BOEING_757_300_cargo_subtype_text;
    passenger_capacity: BOEING_757_300_cargo_subtype_capacity;
    speed: BOEING_757_300_speed;
    running_cost_factor: BOEING_757_300_running_cost_factor;
    sound_effect: BOEING_757_300_sound_effect;

    cost_factor: 79;
    purchase_running_cost_factor: 93;
    purchase_speed: plane_speed_kmh(934);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, BOEING_757_300)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, BOEING_757_300)
  {
    property
    { range: 1273; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, BOEING_757_300)
  {
    property
    { range: 1912; }
  }
}
