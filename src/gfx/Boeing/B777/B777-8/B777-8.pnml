// 灰阶基底（占位复用 Boeing_777_300 灰阶图）
#define IMAGEFILE  "src/gfx/Boeing/B777/B777-300/(0)Greyscale.png"
purchase_sprite(BOEING_777_8, 390, 5, 70, 24, -30, -12)
BOEING_777_8_sprite_layout_template(BOEING_777_8_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B777/B777-300/ANA.png"
BOEING_777_8_sprite_layout_template(BOEING_777_8_ANA)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B777/B777-300/ANAWaves.png"
BOEING_777_8_sprite_layout_template(BOEING_777_8_ANAWaves)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B777/B777-300/CathayPacific.png"
BOEING_777_8_sprite_layout_template(BOEING_777_8_CathayPacific)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B777/B777-300/Emirates.png"
BOEING_777_8_sprite_layout_template(BOEING_777_8_Emirates)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B777/B777-300/JAL.png"
BOEING_777_8_sprite_layout_template(BOEING_777_8_JAL)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, BOEING_777_8_Greyscale, flight_state())
{
  15: BOEING_777_8_Greyscale_Climbing;
  18: BOEING_777_8_Greyscale_Flight;
  21: BOEING_777_8_Greyscale_Landing;
  22: BOEING_777_8_Greyscale_Touchdown;
      BOEING_777_8_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_777_8_ANA, flight_state())
{
  15: BOEING_777_8_ANA_Climbing;
  18: BOEING_777_8_ANA_Flight;
  21: BOEING_777_8_ANA_Landing;
  22: BOEING_777_8_ANA_Touchdown;
      BOEING_777_8_ANA_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_777_8_ANAWaves, flight_state())
{
  15: BOEING_777_8_ANAWaves_Climbing;
  18: BOEING_777_8_ANAWaves_Flight;
  21: BOEING_777_8_ANAWaves_Landing;
  22: BOEING_777_8_ANAWaves_Touchdown;
      BOEING_777_8_ANAWaves_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_777_8_CathayPacific, flight_state())
{
  15: BOEING_777_8_CathayPacific_Climbing;
  18: BOEING_777_8_CathayPacific_Flight;
  21: BOEING_777_8_CathayPacific_Landing;
  22: BOEING_777_8_CathayPacific_Touchdown;
      BOEING_777_8_CathayPacific_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_777_8_Emirates, flight_state())
{
  15: BOEING_777_8_Emirates_Climbing;
  18: BOEING_777_8_Emirates_Flight;
  21: BOEING_777_8_Emirates_Landing;
  22: BOEING_777_8_Emirates_Touchdown;
      BOEING_777_8_Emirates_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_777_8_JAL, flight_state())
{
  15: BOEING_777_8_JAL_Climbing;
  18: BOEING_777_8_JAL_Flight;
  21: BOEING_777_8_JAL_Landing;
  22: BOEING_777_8_JAL_Touchdown;
      BOEING_777_8_JAL_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_777_8_sprites, cargo_subtype)
{
  1: BOEING_777_8_ANA;
  2: BOEING_777_8_ANAWaves;
  3: BOEING_777_8_CathayPacific;
  4: BOEING_777_8_Emirates;
  5: BOEING_777_8_JAL;
     BOEING_777_8_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_777_8_running_cost_factor, flight_state())
{
  plane_RC(226)
}

switch (FEAT_AIRCRAFT, SELF, BOEING_777_8_speed, flight_state())
{
  12..13: return plane_speed_kmh(273); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(451); // airplane climbing after take-off
      18: return plane_speed_kmh(905); // heading for tower contact point
  16..20: return plane_speed_kmh(459); // in flight
  21..22: return plane_speed_kmh(273); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

switch (FEAT_AIRCRAFT, SELF, BOEING_777_8_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_777_8_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_BOEING_777_8);
  1: string(STR_VLIV_ANA);
  2: string(STR_VLIV_ANA_WAVES);
  3: string(STR_VLIV_CATHAY_PACIFIC);
  4: string(STR_VLIV_EMIRATES);
  5: string(STR_VLIV_JAL);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_777_8_cargo_subtype_capacity, cargo_subtype)
{
  1: return 365;
  2: return 365;
  3: return 365;
  4: return 365;
  5: return 365;
     return 365;
}

item (FEAT_AIRCRAFT, BOEING_777_8)
{
  property
  {
    name: string(STR_AIRV_BOEING_777_8);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2027), 1, 1);
    vehicle_life: 30;
    model_life: get_model_life(1998,2050);
    retire_early: get_retire_early(1998,2050);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_LARGE;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 26;
    passenger_capacity: 395;
    mail_capacity: 37;
    acceleration: 27;
    range: 3198;
    sound_effect: SOUND_TAKEOFF_JET_BIG;
  }
  graphics {
    default: BOEING_777_8_sprites;
    purchase: BOEING_777_8_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: BOEING_777_8_cargo_subtype_text;
    passenger_capacity: BOEING_777_8_cargo_subtype_capacity;
    speed: BOEING_777_8_speed;
    running_cost_factor: BOEING_777_8_running_cost_factor;
    sound_effect: BOEING_777_8_sound_effect;

    cost_factor: 262;
    purchase_running_cost_factor: 226;
    purchase_speed: plane_speed_kmh(905);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, BOEING_777_8)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, BOEING_777_8)
  {
    property
    { range: 3198; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, BOEING_777_8)
  {
    property
    { range: 4805; }
  }
}
