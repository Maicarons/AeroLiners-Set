switch (FEAT_AIRCRAFT, SELF, BOEING_737MAX7_sprites, cargo_subtype)
{
  1: BOEING_737MAX7_Aeromexico;
  2: BOEING_737MAX7_AirChina;
  3: BOEING_737MAX7_AirEuropa;
  4: BOEING_737MAX7_American;
  5: BOEING_737MAX7_Belavia;
     BOEING_737MAX7_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_737MAX7_running_cost_factor, flight_state())
{
  plane_RC(71)
}

switch (FEAT_AIRCRAFT, SELF, BOEING_737MAX7_speed, flight_state())
{
  // [speed-constant] 巡航速度恒定，不随飞行状态变化。
  // OpenTTD 将速度属性回调（CB36）的结果缓存于 cached_max_speed，仅在载具
  // 创建、机场状态切换和读档时刷新；按 flight_state 返回不同速度会让缓存
  // 卡在旧值上（起飞后停在跑道速度；读档后跑道速度变成巡航速度）。
  // 滑行/进近/刹车减速由游戏原生状态机按巡航速度自动派生，无需在此压低。
  return plane_speed_kmh(839); // cruise, keep in sync with purchase_speed
}

switch (FEAT_AIRCRAFT, SELF, BOEING_737MAX7_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_737MAX7_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_BOEING_737MAX7);
  1: string(STR_VLIV_AEROMEXICO);
  2: string(STR_VLIV_AIR_CHINA);
  3: string(STR_VLIV_AIR_EUROPA);
  4: string(STR_VLIV_AMERICAN_AIRLINES);
  5: string(STR_VLIV_BELAVIA);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, BOEING_737MAX7_cargo_subtype_capacity, cargo_subtype)
{
  1: return 150;
  2: return 150;
  3: return 150;
  4: return 150;
  5: return 150;
     return 150;
}

item (FEAT_AIRCRAFT, BOEING_737MAX7)
{
  property
  {
    name: string(STR_AIRV_BOEING_737MAX7);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2026), 1, 1);
    vehicle_life: 30;
    model_life: get_model_life(2017,2272);
    retire_early: get_retire_early(2017,2272);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 22;
    passenger_capacity: 153;
    mail_capacity: 15;
    acceleration: 27;
    range: 1273;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: BOEING_737MAX7_sprites;
    purchase: BOEING_737MAX7_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: BOEING_737MAX7_cargo_subtype_text;
    passenger_capacity: BOEING_737MAX7_cargo_subtype_capacity;
    speed: BOEING_737MAX7_speed;
    running_cost_factor: BOEING_737MAX7_running_cost_factor;
    sound_effect: BOEING_737MAX7_sound_effect;

    cost_factor: 101;
    purchase_running_cost_factor: 71;
    purchase_speed: plane_speed_kmh(839);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, BOEING_737MAX7)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, BOEING_737MAX7)
  {
    property
    { range: 1273; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, BOEING_737MAX7)
  {
    property
    { range: 1907; }
  }
}
