  15: BOEING_737MAX7_Greyscale_Climbing;
  18: BOEING_737MAX7_Greyscale_Flight;
  21: BOEING_737MAX7_Greyscale_Landing;
  22: BOEING_737MAX7_Greyscale_Touchdown;
      BOEING_737MAX7_Greyscale_Grounded;
}

