// 灰阶基底（占位复用 Boeing_737_300 灰阶图）
#define IMAGEFILE  "src/gfx/Boeing/B737/B737-300/(0)Greyscale.png"
purchase_sprite(CONVAIR_990, 267, 2, 42, 23, -21, -12)
CONVAIR_990_sprite_layout_template(CONVAIR_990_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B737/B737-300/ABAirlines.png"
CONVAIR_990_sprite_layout_template(CONVAIR_990_ABAirlines)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B737/B737-300/AirBaltic.png"
CONVAIR_990_sprite_layout_template(CONVAIR_990_AirBaltic)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B737/B737-300/AirBerlin.png"
CONVAIR_990_sprite_layout_template(CONVAIR_990_AirBerlin)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B737/B737-300/AirEuropa.png"
CONVAIR_990_sprite_layout_template(CONVAIR_990_AirEuropa)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B737/B737-300/AirOne.png"
CONVAIR_990_sprite_layout_template(CONVAIR_990_AirOne)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, CONVAIR_990_Greyscale, flight_state())
{
  15: CONVAIR_990_Greyscale_Climbing;
  18: CONVAIR_990_Greyscale_Flight;
  21: CONVAIR_990_Greyscale_Landing;
  22: CONVAIR_990_Greyscale_Touchdown;
      CONVAIR_990_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CONVAIR_990_ABAirlines, flight_state())
{
  15: CONVAIR_990_ABAirlines_Climbing;
  18: CONVAIR_990_ABAirlines_Flight;
  21: CONVAIR_990_ABAirlines_Landing;
  22: CONVAIR_990_ABAirlines_Touchdown;
      CONVAIR_990_ABAirlines_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CONVAIR_990_AirBaltic, flight_state())
{
  15: CONVAIR_990_AirBaltic_Climbing;
  18: CONVAIR_990_AirBaltic_Flight;
  21: CONVAIR_990_AirBaltic_Landing;
  22: CONVAIR_990_AirBaltic_Touchdown;
      CONVAIR_990_AirBaltic_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CONVAIR_990_AirBerlin, flight_state())
{
  15: CONVAIR_990_AirBerlin_Climbing;
  18: CONVAIR_990_AirBerlin_Flight;
  21: CONVAIR_990_AirBerlin_Landing;
  22: CONVAIR_990_AirBerlin_Touchdown;
      CONVAIR_990_AirBerlin_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CONVAIR_990_AirEuropa, flight_state())
{
  15: CONVAIR_990_AirEuropa_Climbing;
  18: CONVAIR_990_AirEuropa_Flight;
  21: CONVAIR_990_AirEuropa_Landing;
  22: CONVAIR_990_AirEuropa_Touchdown;
      CONVAIR_990_AirEuropa_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CONVAIR_990_AirOne, flight_state())
{
  15: CONVAIR_990_AirOne_Climbing;
  18: CONVAIR_990_AirOne_Flight;
  21: CONVAIR_990_AirOne_Landing;
  22: CONVAIR_990_AirOne_Touchdown;
      CONVAIR_990_AirOne_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CONVAIR_990_sprites, cargo_subtype)
{
  1: CONVAIR_990_ABAirlines;
  2: CONVAIR_990_AirBaltic;
  3: CONVAIR_990_AirBerlin;
  4: CONVAIR_990_AirEuropa;
  5: CONVAIR_990_AirOne;
     CONVAIR_990_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, CONVAIR_990_running_cost_factor, flight_state())
{
  plane_RC(64)
}

switch (FEAT_AIRCRAFT, SELF, CONVAIR_990_speed, flight_state())
{
  12..13: return plane_speed_kmh(245); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(404); // airplane climbing after take-off
      18: return plane_speed_kmh(896); // heading for tower contact point
  16..20: return plane_speed_kmh(460); // in flight
  21..22: return plane_speed_kmh(245); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(198);
}

switch (FEAT_AIRCRAFT, SELF, CONVAIR_990_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, CONVAIR_990_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_CONVAIR_990);
  1: string(STR_VLIV_AB_AIRLINES);
  2: string(STR_VLIV_AIR_BALTIC);
  3: string(STR_VLIV_AIR_BERLIN);
  4: string(STR_VLIV_AIR_EUROPA);
  5: string(STR_VLIV_AIR_ONE);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, CONVAIR_990_cargo_subtype_capacity, cargo_subtype)
{
  1: return 120;
  2: return 120;
  3: return 120;
  4: return 120;
  5: return 120;
     return 120;
}

item (FEAT_AIRCRAFT, CONVAIR_990)
{
  property
  {
    name: string(STR_AIRV_CONVAIR_990);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1961), 1, 1);
    vehicle_life: 30;
    model_life: get_model_life(1984,1994);
    retire_early: get_retire_early(1984,1994);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 18;
    passenger_capacity: 149;
    mail_capacity: 14;
    acceleration: 27;
    range: 1112;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: CONVAIR_990_sprites;
    purchase: CONVAIR_990_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: CONVAIR_990_cargo_subtype_text;
    passenger_capacity: CONVAIR_990_cargo_subtype_capacity;
    speed: CONVAIR_990_speed;
    running_cost_factor: CONVAIR_990_running_cost_factor;
    sound_effect: CONVAIR_990_sound_effect;

    cost_factor: 42;
    purchase_running_cost_factor: 64;
    purchase_speed: plane_speed_kmh(896);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, CONVAIR_990)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, CONVAIR_990)
  {
    property
    { range: 1112; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, CONVAIR_990)
  {
    property
    { range: 1672; }
  }
}
