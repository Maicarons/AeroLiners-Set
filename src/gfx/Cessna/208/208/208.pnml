switch (FEAT_AIRCRAFT, SELF, CESSNA_208_sprites, cargo_subtype)
{
  1: CESSNA_208_AerArran;
  2: CESSNA_208_AirDeccan;
  3: CESSNA_208_AirDolomiti;
  4: CESSNA_208_Airlinair;
  5: CESSNA_208_AirNostrum;
     CESSNA_208_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_208_running_cost_factor, flight_state())
{
  plane_RC(39)
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_208_speed, flight_state())
{
  // [speed-constant] 巡航速度恒定，不随飞行状态变化。
  // OpenTTD 将速度属性回调（CB36）的结果缓存于 cached_max_speed，仅在载具
  // 创建、机场状态切换和读档时刷新；按 flight_state 返回不同速度会让缓存
  // 卡在旧值上（起飞后停在跑道速度；读档后跑道速度变成巡航速度）。
  // 滑行/进近/刹车减速由游戏原生状态机按巡航速度自动派生，无需在此压低。
  return plane_speed_kmh(344); // cruise, keep in sync with purchase_speed
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_208_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_208_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_CESSNA_208);
  1: string(STR_VLIV_AER_ARRAN_RINGED_DESIGN);
  2: string(STR_VLIV_AIR_DECCAN);
  3: string(STR_VLIV_AIR_DOLOMITI);
  4: string(STR_VLIV_AIRLINAIR_AIR_FRANCE);
  5: string(STR_VLIV_AIR_NOSTRUM_IBERIA_REGIONAL);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_208_cargo_subtype_capacity, cargo_subtype)
{
  1: return 13;
  2: return 13;
  3: return 13;
  4: return 13;
  5: return 13;
     return 13;
}

item (FEAT_AIRCRAFT, CESSNA_208)
{
  property
  {
    name: string(STR_AIRV_CESSNA_208);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1984), 1, 1);
    vehicle_life: 11;
    model_life: get_model_life(1997,2024);
    retire_early: get_retire_early(1997,2024);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 16;
    passenger_capacity: 9;
    mail_capacity: 2;
    acceleration: 27;
    range: 360;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: CESSNA_208_sprites;
    purchase: CESSNA_208_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: CESSNA_208_cargo_subtype_text;
    passenger_capacity: CESSNA_208_cargo_subtype_capacity;
    speed: CESSNA_208_speed;
    running_cost_factor: CESSNA_208_running_cost_factor;
    sound_effect: CESSNA_208_sound_effect;

    cost_factor: 18;
    purchase_running_cost_factor: 39;
    purchase_speed: plane_speed_kmh(344);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, CESSNA_208)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, CESSNA_208)
  {
    property
    { range: 360; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, CESSNA_208)
  {
    property
    { range: 543; }
  }
}
