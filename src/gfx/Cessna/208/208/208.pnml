switch (FEAT_AIRCRAFT, SELF, CESSNA_208_Greyscale, flight_state())
{
  15: CESSNA_208_Greyscale_Climbing;
  18: CESSNA_208_Greyscale_Flight;
  21: CESSNA_208_Greyscale_Landing;
  22: CESSNA_208_Greyscale_Touchdown;
      CESSNA_208_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_208_AerArran, flight_state())
{
  15: CESSNA_208_AerArran_Climbing;
  18: CESSNA_208_AerArran_Flight;
  21: CESSNA_208_AerArran_Landing;
  22: CESSNA_208_AerArran_Touchdown;
      CESSNA_208_AerArran_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_208_AirDeccan, flight_state())
{
  15: CESSNA_208_AirDeccan_Climbing;
  18: CESSNA_208_AirDeccan_Flight;
  21: CESSNA_208_AirDeccan_Landing;
  22: CESSNA_208_AirDeccan_Touchdown;
      CESSNA_208_AirDeccan_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_208_AirDolomiti, flight_state())
{
  15: CESSNA_208_AirDolomiti_Climbing;
  18: CESSNA_208_AirDolomiti_Flight;
  21: CESSNA_208_AirDolomiti_Landing;
  22: CESSNA_208_AirDolomiti_Touchdown;
      CESSNA_208_AirDolomiti_Grounded;
