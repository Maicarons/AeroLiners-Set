// 灰阶基底（占位复用 ATR_72_500 灰阶图）

// 灰阶基底（占位复用 ATR_72_600 灰阶图）
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/(0)Greyscale.png"
purchase_sprite(CESSNA_408, 283, 1, 50, 23, -25, -12)
CESSNA_408_sprite_layout_template(CESSNA_408_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AerArran.png"
CESSNA_408_sprite_layout_template(CESSNA_408_AerArran)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AirDeccan.png"
CESSNA_408_sprite_layout_template(CESSNA_408_AirDeccan)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AirDolomiti.png"
CESSNA_408_sprite_layout_template(CESSNA_408_AirDolomiti)
#undef IMAGEFILE
