CESSNA_408_sprite_layout_template(CESSNA_408_Airlinair)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AirNostrum.png"
CESSNA_408_sprite_layout_template(CESSNA_408_AirNostrum)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, CESSNA_408_Greyscale, flight_state())
{
  15: CESSNA_408_Greyscale_Climbing;
  18: CESSNA_408_Greyscale_Flight;
  21: CESSNA_408_Greyscale_Landing;
  22: CESSNA_408_Greyscale_Touchdown;
      CESSNA_408_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_408_AerArran, flight_state())
{
  15: CESSNA_408_AerArran_Climbing;
  18: CESSNA_408_AerArran_Flight;
  21: CESSNA_408_AerArran_Landing;
  22: CESSNA_408_AerArran_Touchdown;
      CESSNA_408_AerArran_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_408_AirDeccan, flight_state())
{
  15: CESSNA_408_AirDeccan_Climbing;
  18: CESSNA_408_AirDeccan_Flight;
  21: CESSNA_408_AirDeccan_Landing;
  22: CESSNA_408_AirDeccan_Touchdown;
      CESSNA_408_AirDeccan_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_408_AirDolomiti, flight_state())
{
  15: CESSNA_408_AirDolomiti_Climbing;
  18: CESSNA_408_AirDolomiti_Flight;
  21: CESSNA_408_AirDolomiti_Landing;
  22: CESSNA_408_AirDolomiti_Touchdown;
      CESSNA_408_AirDolomiti_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_408_Airlinair, flight_state())
{
  15: CESSNA_408_Airlinair_Climbing;
  18: CESSNA_408_Airlinair_Flight;
  21: CESSNA_408_Airlinair_Landing;
  22: CESSNA_408_Airlinair_Touchdown;
      CESSNA_408_Airlinair_Grounded;
