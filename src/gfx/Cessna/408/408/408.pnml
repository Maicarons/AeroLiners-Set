switch (FEAT_AIRCRAFT, SELF, CESSNA_408_AirNostrum, flight_state())
{
  15: CESSNA_408_AirNostrum_Climbing;
  18: CESSNA_408_AirNostrum_Flight;
  21: CESSNA_408_AirNostrum_Landing;
  22: CESSNA_408_AirNostrum_Touchdown;
      CESSNA_408_AirNostrum_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_408_sprites, cargo_subtype)
{
  1: CESSNA_408_AerArran;
  2: CESSNA_408_AirDeccan;
  3: CESSNA_408_AirDolomiti;
  4: CESSNA_408_Airlinair;
  5: CESSNA_408_AirNostrum;
     CESSNA_408_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_408_running_cost_factor, flight_state())
{
  plane_RC(39)
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_408_speed, flight_state())
{
  12..13: return plane_speed_kmh(194); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(261); // airplane climbing after take-off
      18: return plane_speed_kmh(388); // heading for tower contact point
  16..20: return plane_speed_kmh(285); // in flight
  21..22: return plane_speed_kmh(163); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(151);
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_408_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_408_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_CESSNA_408);
  1: string(STR_VLIV_AER_ARRAN_RINGED_DESIGN);
  2: string(STR_VLIV_AIR_DECCAN);
  3: string(STR_VLIV_AIR_DOLOMITI);
  4: string(STR_VLIV_AIRLINAIR_AIR_FRANCE);
  5: string(STR_VLIV_AIR_NOSTRUM_IBERIA_REGIONAL);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_408_cargo_subtype_capacity, cargo_subtype)
{
  1: return 19;
  2: return 19;
  3: return 19;
  4: return 19;
  5: return 19;
     return 19;
}

item (FEAT_AIRCRAFT, CESSNA_408)
{
  property
  {
    name: string(STR_AIRV_CESSNA_408);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2022), 1, 1);
    vehicle_life: 11;
    model_life: get_model_life(1997,2024);
    retire_early: get_retire_early(1997,2024);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 16;
    passenger_capacity: 19;
    mail_capacity: 2;
    acceleration: 27;
    range: 304;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: CESSNA_408_sprites;
    purchase: CESSNA_408_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: CESSNA_408_cargo_subtype_text;
    passenger_capacity: CESSNA_408_cargo_subtype_capacity;
    speed: CESSNA_408_speed;
    running_cost_factor: CESSNA_408_running_cost_factor;
    sound_effect: CESSNA_408_sound_effect;

    cost_factor: 18;
    purchase_running_cost_factor: 39;
    purchase_speed: plane_speed_kmh(388);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, CESSNA_408)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, CESSNA_408)
  {
    property
    { range: 304; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, CESSNA_408)
  {
    property
    { range: 459; }
  }
}
