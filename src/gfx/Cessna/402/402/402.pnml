  [ 52, 78, 38, 27, -19, -14, ANIM]                                          \
  [ 95, 78, 48, 23, -24, -12, ANIM]                                          \
  [147, 78, 38, 17, -19, -9 , ANIM]                                          \
  [190, 78, 44, 20, -22, -10, ANIM]                                          \
  [239, 78, 38, 17, -19, -9 , ANIM]                                          \
