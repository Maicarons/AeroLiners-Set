// 灰阶基底（占位复用 ATR_42_500 灰阶图）
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/(0)Greyscale.png"
purchase_sprite(CESSNA_402, 285, 1, 46, 23, -23, -12)
CESSNA_402_sprite_layout_template(CESSNA_402_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/AirFrance.png"
CESSNA_402_sprite_layout_template(CESSNA_402_AirFrance)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/CSA.png"
CESSNA_402_sprite_layout_template(CESSNA_402_CSA)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/Satena.png"
CESSNA_402_sprite_layout_template(CESSNA_402_Satena)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, CESSNA_402_Greyscale, flight_state())
{
  15: CESSNA_402_Greyscale_Climbing;
  18: CESSNA_402_Greyscale_Flight;
  21: CESSNA_402_Greyscale_Landing;
  22: CESSNA_402_Greyscale_Touchdown;
      CESSNA_402_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_402_AirFrance, flight_state())
{
  15: CESSNA_402_AirFrance_Climbing;
  18: CESSNA_402_AirFrance_Flight;
  21: CESSNA_402_AirFrance_Landing;
  22: CESSNA_402_AirFrance_Touchdown;
      CESSNA_402_AirFrance_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_402_CSA, flight_state())
{
  15: CESSNA_402_CSA_Climbing;
  18: CESSNA_402_CSA_Flight;
  21: CESSNA_402_CSA_Landing;
  22: CESSNA_402_CSA_Touchdown;
      CESSNA_402_CSA_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_402_Satena, flight_state())
{
  15: CESSNA_402_Satena_Climbing;
  18: CESSNA_402_Satena_Flight;
  21: CESSNA_402_Satena_Landing;
  22: CESSNA_402_Satena_Touchdown;
      CESSNA_402_Satena_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_402_sprites, cargo_subtype)
{
  1: CESSNA_402_AirFrance;
  2: CESSNA_402_CSA;
  3: CESSNA_402_Satena;
     CESSNA_402_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_402_running_cost_factor, flight_state())
{
  plane_RC(38)
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_402_speed, flight_state())
{
  12..13: return plane_speed_kmh(173); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(233); // airplane climbing after take-off
      18: return plane_speed_kmh(263); // heading for tower contact point
  16..20: return plane_speed_kmh(228); // in flight
  21..22: return plane_speed_kmh(141); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(135);
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_402_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_402_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_CESSNA_402);
  1: string(STR_VLIV_AIR_FRANCE);
  2: string(STR_VLIV_CZECH_AIRLINES);
  3: string(STR_VLIV_SATENA);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, CESSNA_402_cargo_subtype_capacity, cargo_subtype)
{
  1: return 8;
  2: return 8;
  3: return 8;
     return 8;
}

item (FEAT_AIRCRAFT, CESSNA_402)
{
  property
  {
    name: string(STR_AIRV_CESSNA_402);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1966), 1, 1);
    vehicle_life: 11;
    model_life: get_model_life(1995,2020);
    retire_early: get_retire_early(1995,2020);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 17;
    passenger_capacity: 10;
    mail_capacity: 1;
    acceleration: 27;
    range: 429;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: CESSNA_402_sprites;
    purchase: CESSNA_402_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: CESSNA_402_cargo_subtype_text;
    passenger_capacity: CESSNA_402_cargo_subtype_capacity;
    speed: CESSNA_402_speed;
    running_cost_factor: CESSNA_402_running_cost_factor;
    sound_effect: CESSNA_402_sound_effect;

    cost_factor: 12;
    purchase_running_cost_factor: 38;
    purchase_speed: plane_speed_kmh(263);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, CESSNA_402)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, CESSNA_402)
  {
    property
    { range: 429; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, CESSNA_402)
  {
    property
    { range: 644; }
  }
}
