// 灰阶基底（占位复用 Ilyushin_62 灰阶图）
#define IMAGEFILE  "src/gfx/Ilyushin/Il62/(0)Greyscale.png"
purchase_sprite(VICKERS_VC10, 370, 6, 59, 21, -30, -11)
VICKERS_VC10_sprite_layout_template(VICKERS_VC10_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Ilyushin/Il62/AeroflotOld.png"
VICKERS_VC10_sprite_layout_template(VICKERS_VC10_AeroflotOld)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Ilyushin/Il62/AirUkraine.png"
