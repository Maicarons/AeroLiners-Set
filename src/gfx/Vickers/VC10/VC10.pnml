VICKERS_VC10_sprite_layout_template(VICKERS_VC10_Interflug)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, VICKERS_VC10_Greyscale, flight_state())
{
  15: VICKERS_VC10_Greyscale_Climbing;
  18: VICKERS_VC10_Greyscale_Flight;
  21: VICKERS_VC10_Greyscale_Landing;
  22: VICKERS_VC10_Greyscale_Touchdown;
      VICKERS_VC10_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VC10_AeroflotOld, flight_state())
{
  15: VICKERS_VC10_AeroflotOld_Climbing;
  18: VICKERS_VC10_AeroflotOld_Flight;
  21: VICKERS_VC10_AeroflotOld_Landing;
  22: VICKERS_VC10_AeroflotOld_Touchdown;
      VICKERS_VC10_AeroflotOld_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VC10_AirUkraine, flight_state())
{
  15: VICKERS_VC10_AirUkraine_Climbing;
  18: VICKERS_VC10_AirUkraine_Flight;
  21: VICKERS_VC10_AirUkraine_Landing;
  22: VICKERS_VC10_AirUkraine_Touchdown;
      VICKERS_VC10_AirUkraine_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VC10_CSA, flight_state())
{
  15: VICKERS_VC10_CSA_Climbing;
  18: VICKERS_VC10_CSA_Flight;
  21: VICKERS_VC10_CSA_Landing;
  22: VICKERS_VC10_CSA_Touchdown;
      VICKERS_VC10_CSA_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VC10_Cubana, flight_state())
{
  15: VICKERS_VC10_Cubana_Climbing;
  18: VICKERS_VC10_Cubana_Flight;
  21: VICKERS_VC10_Cubana_Landing;
  22: VICKERS_VC10_Cubana_Touchdown;
      VICKERS_VC10_Cubana_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VC10_Interflug, flight_state())
{
  15: VICKERS_VC10_Interflug_Climbing;
  18: VICKERS_VC10_Interflug_Flight;
  21: VICKERS_VC10_Interflug_Landing;
  22: VICKERS_VC10_Interflug_Touchdown;
      VICKERS_VC10_Interflug_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VC10_sprites, cargo_subtype)
{
  1: VICKERS_VC10_AeroflotOld;
  2: VICKERS_VC10_AirUkraine;
  3: VICKERS_VC10_CSA;
  4: VICKERS_VC10_Cubana;
  5: VICKERS_VC10_Interflug;
     VICKERS_VC10_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VC10_running_cost_factor, flight_state())
{
  plane_RC(42)
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VC10_speed, flight_state())
{
  // [speed-constant] 巡航速度恒定，不随飞行状态变化。
  // OpenTTD 将速度属性回调（CB36）的结果缓存于 cached_max_speed，仅在载具
  // 创建、机场状态切换和读档时刷新；按 flight_state 返回不同速度会让缓存
  // 卡在旧值上（起飞后停在跑道速度；读档后跑道速度变成巡航速度）。
  // 滑行/进近/刹车减速由游戏原生状态机按巡航速度自动派生，无需在此压低。
  return plane_speed_kmh(890); // cruise, keep in sync with purchase_speed
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VC10_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VC10_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_VICKERS_VC10);
  1: string(STR_VLIV_AEROFLOT_OLD);
  2: string(STR_VLIV_UKRAINE_INTERNATIONAL_AIRLINES);
  3: string(STR_VLIV_CZECH_AIRLINES);
  4: string(STR_VLIV_CUBANA_DE_AVIACION);
  5: string(STR_VLIV_INTERFLUG);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VC10_cargo_subtype_capacity, cargo_subtype)
{
  1: return 145;
  2: return 145;
  3: return 145;
  4: return 145;
  5: return 145;
     return 145;
}

item (FEAT_AIRCRAFT, VICKERS_VC10)
{
  property
  {
    name: string(STR_AIRV_VICKERS_VC10);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1962), 1, 1);
    vehicle_life: 15;
    model_life: get_model_life(1967,1995);
    retire_early: get_retire_early(1967,1995);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_LARGE;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 22;
    passenger_capacity: 151;
    mail_capacity: 15;
    acceleration: 27;
    range: 1711;
    sound_effect: SOUND_TAKEOFF_JET_BIG;
  }
  graphics {
    default: VICKERS_VC10_sprites;
    purchase: VICKERS_VC10_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: VICKERS_VC10_cargo_subtype_text;
    passenger_capacity: VICKERS_VC10_cargo_subtype_capacity;
    speed: VICKERS_VC10_speed;
    running_cost_factor: VICKERS_VC10_running_cost_factor;
    sound_effect: VICKERS_VC10_sound_effect;

    cost_factor: 169;
    purchase_running_cost_factor: 42;
    purchase_speed: plane_speed_kmh(890);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, VICKERS_VC10)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, VICKERS_VC10)
  {
    property
    { range: 1711; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, VICKERS_VC10)
  {
    property
    { range: 2566; }
  }
}
