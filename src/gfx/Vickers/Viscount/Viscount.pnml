// 灰阶基底（占位复用 ATR_42_500 灰阶图）
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/(0)Greyscale.png"
purchase_sprite(VICKERS_VISCOUNT, 285, 1, 46, 23, -23, -12)
VICKERS_VISCOUNT_sprite_layout_template(VICKERS_VISCOUNT_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/AirFrance.png"
VICKERS_VISCOUNT_sprite_layout_template(VICKERS_VISCOUNT_AirFrance)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/CSA.png"
VICKERS_VISCOUNT_sprite_layout_template(VICKERS_VISCOUNT_CSA)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/Satena.png"
VICKERS_VISCOUNT_sprite_layout_template(VICKERS_VISCOUNT_Satena)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, VICKERS_VISCOUNT_Greyscale, flight_state())
{
  15: VICKERS_VISCOUNT_Greyscale_Climbing;
  18: VICKERS_VISCOUNT_Greyscale_Flight;
  21: VICKERS_VISCOUNT_Greyscale_Landing;
  22: VICKERS_VISCOUNT_Greyscale_Touchdown;
      VICKERS_VISCOUNT_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VISCOUNT_AirFrance, flight_state())
{
  15: VICKERS_VISCOUNT_AirFrance_Climbing;
  18: VICKERS_VISCOUNT_AirFrance_Flight;
  21: VICKERS_VISCOUNT_AirFrance_Landing;
  22: VICKERS_VISCOUNT_AirFrance_Touchdown;
      VICKERS_VISCOUNT_AirFrance_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VISCOUNT_CSA, flight_state())
{
  15: VICKERS_VISCOUNT_CSA_Climbing;
  18: VICKERS_VISCOUNT_CSA_Flight;
  21: VICKERS_VISCOUNT_CSA_Landing;
  22: VICKERS_VISCOUNT_CSA_Touchdown;
      VICKERS_VISCOUNT_CSA_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VISCOUNT_Satena, flight_state())
{
  15: VICKERS_VISCOUNT_Satena_Climbing;
  18: VICKERS_VISCOUNT_Satena_Flight;
  21: VICKERS_VISCOUNT_Satena_Landing;
  22: VICKERS_VISCOUNT_Satena_Touchdown;
      VICKERS_VISCOUNT_Satena_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VISCOUNT_sprites, cargo_subtype)
{
  1: VICKERS_VISCOUNT_AirFrance;
  2: VICKERS_VISCOUNT_CSA;
  3: VICKERS_VISCOUNT_Satena;
     VICKERS_VISCOUNT_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VISCOUNT_running_cost_factor, flight_state())
{
  plane_RC(38)
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VISCOUNT_speed, flight_state())
{
  12..13: return plane_speed_kmh(239); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(322); // airplane climbing after take-off
      18: return plane_speed_kmh(566); // heading for tower contact point
  16..20: return plane_speed_kmh(315); // in flight
  21..22: return plane_speed_kmh(195); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(187);
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VISCOUNT_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VISCOUNT_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_VICKERS_VISCOUNT);
  1: string(STR_VLIV_AIR_FRANCE);
  2: string(STR_VLIV_CZECH_AIRLINES);
  3: string(STR_VLIV_SATENA);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, VICKERS_VISCOUNT_cargo_subtype_capacity, cargo_subtype)
{
  1: return 60;
  2: return 60;
  3: return 60;
     return 60;
}

item (FEAT_AIRCRAFT, VICKERS_VISCOUNT)
{
  property
  {
    name: string(STR_AIRV_VICKERS_VISCOUNT);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1953), 1, 1);
    vehicle_life: 11;
    model_life: get_model_life(1995,2020);
    retire_early: get_retire_early(1995,2020);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 17;
    passenger_capacity: 75;
    mail_capacity: 6;
    acceleration: 27;
    range: 404;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: VICKERS_VISCOUNT_sprites;
    purchase: VICKERS_VISCOUNT_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: VICKERS_VISCOUNT_cargo_subtype_text;
    passenger_capacity: VICKERS_VISCOUNT_cargo_subtype_capacity;
    speed: VICKERS_VISCOUNT_speed;
    running_cost_factor: VICKERS_VISCOUNT_running_cost_factor;
    sound_effect: VICKERS_VISCOUNT_sound_effect;

    cost_factor: 14;
    purchase_running_cost_factor: 38;
    purchase_speed: plane_speed_kmh(566);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, VICKERS_VISCOUNT)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, VICKERS_VISCOUNT)
  {
    property
    { range: 404; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, VICKERS_VISCOUNT)
  {
    property
    { range: 606; }
  }
}
