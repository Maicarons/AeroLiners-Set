// 灰阶基底（占位复用 ATR_42_500 灰阶图）

// 灰阶基底（占位复用 ATR_42_600 灰阶图）
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/(0)Greyscale.png"
purchase_sprite(BRITTEN_NORMAN_BN2T, 285, 1, 46, 23, -23, -12)
BRITTEN_NORMAN_BN2T_sprite_layout_template(BRITTEN_NORMAN_BN2T_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/AirFrance.png"
BRITTEN_NORMAN_BN2T_sprite_layout_template(BRITTEN_NORMAN_BN2T_AirFrance)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/CSA.png"
BRITTEN_NORMAN_BN2T_sprite_layout_template(BRITTEN_NORMAN_BN2T_CSA)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR42/42-500/Satena.png"
BRITTEN_NORMAN_BN2T_sprite_layout_template(BRITTEN_NORMAN_BN2T_Satena)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, BRITTEN_NORMAN_BN2T_Greyscale, flight_state())
{
  15: BRITTEN_NORMAN_BN2T_Greyscale_Climbing;
  18: BRITTEN_NORMAN_BN2T_Greyscale_Flight;
  21: BRITTEN_NORMAN_BN2T_Greyscale_Landing;
  22: BRITTEN_NORMAN_BN2T_Greyscale_Touchdown;
      BRITTEN_NORMAN_BN2T_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BRITTEN_NORMAN_BN2T_AirFrance, flight_state())
{
  15: BRITTEN_NORMAN_BN2T_AirFrance_Climbing;
  18: BRITTEN_NORMAN_BN2T_AirFrance_Flight;
  21: BRITTEN_NORMAN_BN2T_AirFrance_Landing;
  22: BRITTEN_NORMAN_BN2T_AirFrance_Touchdown;
      BRITTEN_NORMAN_BN2T_AirFrance_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BRITTEN_NORMAN_BN2T_CSA, flight_state())
{
  15: BRITTEN_NORMAN_BN2T_CSA_Climbing;
  18: BRITTEN_NORMAN_BN2T_CSA_Flight;
  21: BRITTEN_NORMAN_BN2T_CSA_Landing;
  22: BRITTEN_NORMAN_BN2T_CSA_Touchdown;
      BRITTEN_NORMAN_BN2T_CSA_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BRITTEN_NORMAN_BN2T_Satena, flight_state())
{
  15: BRITTEN_NORMAN_BN2T_Satena_Climbing;
  18: BRITTEN_NORMAN_BN2T_Satena_Flight;
  21: BRITTEN_NORMAN_BN2T_Satena_Landing;
  22: BRITTEN_NORMAN_BN2T_Satena_Touchdown;
      BRITTEN_NORMAN_BN2T_Satena_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, BRITTEN_NORMAN_BN2T_sprites, cargo_subtype)
{
  1: BRITTEN_NORMAN_BN2T_AirFrance;
  2: BRITTEN_NORMAN_BN2T_CSA;
  3: BRITTEN_NORMAN_BN2T_Satena;
     BRITTEN_NORMAN_BN2T_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, BRITTEN_NORMAN_BN2T_running_cost_factor, flight_state())
{
  plane_RC(38)
}

switch (FEAT_AIRCRAFT, SELF, BRITTEN_NORMAN_BN2T_speed, flight_state())
{
  12..13: return plane_speed_kmh(149); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(200); // airplane climbing after take-off
      18: return plane_speed_kmh(326); // heading for tower contact point
  16..20: return plane_speed_kmh(195); // in flight
  21..22: return plane_speed_kmh(121); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(116);
}

switch (FEAT_AIRCRAFT, SELF, BRITTEN_NORMAN_BN2T_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, BRITTEN_NORMAN_BN2T_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_BRITTEN_NORMAN_BN2T);
  1: string(STR_VLIV_AIR_FRANCE);
  2: string(STR_VLIV_CZECH_AIRLINES);
  3: string(STR_VLIV_SATENA);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, BRITTEN_NORMAN_BN2T_cargo_subtype_capacity, cargo_subtype)
{
  1: return 9;
  2: return 9;
  3: return 9;
     return 9;
}

item (FEAT_AIRCRAFT, BRITTEN_NORMAN_BN2T)
{
  property
  {
    name: string(STR_AIRV_BRITTEN_NORMAN_BN2T);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1978), 1, 1);
    vehicle_life: 11;
    model_life: get_model_life(1995,2020);
    retire_early: get_retire_early(1995,2020);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 17;
    passenger_capacity: 9;
    mail_capacity: 1;
    acceleration: 27;
    range: 244;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: BRITTEN_NORMAN_BN2T_sprites;
    purchase: BRITTEN_NORMAN_BN2T_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: BRITTEN_NORMAN_BN2T_cargo_subtype_text;
    passenger_capacity: BRITTEN_NORMAN_BN2T_cargo_subtype_capacity;
    speed: BRITTEN_NORMAN_BN2T_speed;
    running_cost_factor: BRITTEN_NORMAN_BN2T_running_cost_factor;
    sound_effect: BRITTEN_NORMAN_BN2T_sound_effect;

    cost_factor: 14;
    purchase_running_cost_factor: 38;
    purchase_speed: plane_speed_kmh(326);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, BRITTEN_NORMAN_BN2T)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, BRITTEN_NORMAN_BN2T)
  {
    property
    { range: 244; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, BRITTEN_NORMAN_BN2T)
  {
    property
    { range: 366; }
  }
}
