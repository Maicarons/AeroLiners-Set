// 灰阶基底（占位复用 Lockheed_L049_Constellation 灰阶图）
#define IMAGEFILE  "src/gfx/Lockheed/Constellation/L049 Constellation/(0)Greyscale.png"
purchase_sprite(DOUGLAS_DC7, 320, 1, 46, 25, -23, -13)
DOUGLAS_DC7_sprite_layout_template(DOUGLAS_DC7_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Lockheed/Constellation/L049 Constellation/AirFrance.png"
DOUGLAS_DC7_sprite_layout_template(DOUGLAS_DC7_AirFrance)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Lockheed/Constellation/L049 Constellation/BOAC.png"
DOUGLAS_DC7_sprite_layout_template(DOUGLAS_DC7_BOAC)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Lockheed/Constellation/L049 Constellation/Braniff.png"
DOUGLAS_DC7_sprite_layout_template(DOUGLAS_DC7_Braniff)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Lockheed/Constellation/L049 Constellation/KLM.png"
DOUGLAS_DC7_sprite_layout_template(DOUGLAS_DC7_KLM)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Lockheed/Constellation/L049 Constellation/TWA.png"
DOUGLAS_DC7_sprite_layout_template(DOUGLAS_DC7_TWA)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, DOUGLAS_DC7_Greyscale, flight_state())
{
  15: DOUGLAS_DC7_Greyscale_Climbing;
  18: DOUGLAS_DC7_Greyscale_Flight;
  21: DOUGLAS_DC7_Greyscale_Landing;
  22: DOUGLAS_DC7_Greyscale_Touchdown;
      DOUGLAS_DC7_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, DOUGLAS_DC7_AirFrance, flight_state())
{
  15: DOUGLAS_DC7_AirFrance_Climbing;
  18: DOUGLAS_DC7_AirFrance_Flight;
  21: DOUGLAS_DC7_AirFrance_Landing;
  22: DOUGLAS_DC7_AirFrance_Touchdown;
      DOUGLAS_DC7_AirFrance_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, DOUGLAS_DC7_BOAC, flight_state())
{
  15: DOUGLAS_DC7_BOAC_Climbing;
  18: DOUGLAS_DC7_BOAC_Flight;
  21: DOUGLAS_DC7_BOAC_Landing;
  22: DOUGLAS_DC7_BOAC_Touchdown;
      DOUGLAS_DC7_BOAC_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, DOUGLAS_DC7_Braniff, flight_state())
{
  15: DOUGLAS_DC7_Braniff_Climbing;
  18: DOUGLAS_DC7_Braniff_Flight;
  21: DOUGLAS_DC7_Braniff_Landing;
  22: DOUGLAS_DC7_Braniff_Touchdown;
      DOUGLAS_DC7_Braniff_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, DOUGLAS_DC7_KLM, flight_state())
{
  15: DOUGLAS_DC7_KLM_Climbing;
  18: DOUGLAS_DC7_KLM_Flight;
  21: DOUGLAS_DC7_KLM_Landing;
  22: DOUGLAS_DC7_KLM_Touchdown;
      DOUGLAS_DC7_KLM_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, DOUGLAS_DC7_TWA, flight_state())
{
  15: DOUGLAS_DC7_TWA_Climbing;
  18: DOUGLAS_DC7_TWA_Flight;
  21: DOUGLAS_DC7_TWA_Landing;
  22: DOUGLAS_DC7_TWA_Touchdown;
      DOUGLAS_DC7_TWA_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, DOUGLAS_DC7_sprites, cargo_subtype)
{
  1: DOUGLAS_DC7_AirFrance;
  2: DOUGLAS_DC7_BOAC;
  3: DOUGLAS_DC7_Braniff;
  4: DOUGLAS_DC7_KLM;
  5: DOUGLAS_DC7_TWA;
     DOUGLAS_DC7_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, DOUGLAS_DC7_running_cost_factor, flight_state())
{
  plane_RC(139)
}

switch (FEAT_AIRCRAFT, SELF, DOUGLAS_DC7_speed, flight_state())
{
  // [speed-constant] 巡航速度恒定，不随飞行状态变化。
  // OpenTTD 将速度属性回调（CB36）的结果缓存于 cached_max_speed，仅在载具
  // 创建、机场状态切换和读档时刷新；按 flight_state 返回不同速度会让缓存
  // 卡在旧值上（起飞后停在跑道速度；读档后跑道速度变成巡航速度）。
  // 滑行/进近/刹车减速由游戏原生状态机按巡航速度自动派生，无需在此压低。
  return plane_speed_kmh(557); // cruise, keep in sync with purchase_speed
}

switch (FEAT_AIRCRAFT, SELF, DOUGLAS_DC7_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, DOUGLAS_DC7_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_DOUGLAS_DC7);
  1: string(STR_VLIV_AIR_FRANCE);
  2: string(STR_VLIV_BOAC);
  3: string(STR_VLIV_BRANIFF);
  4: string(STR_VLIV_KLM);
  5: string(STR_VLIV_TWA);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, DOUGLAS_DC7_cargo_subtype_capacity, cargo_subtype)
{
  1: return 95;
  2: return 95;
  3: return 95;
  4: return 95;
  5: return 95;
     return 95;
}

item (FEAT_AIRCRAFT, DOUGLAS_DC7)
{
  property
  {
    name: string(STR_AIRV_DOUGLAS_DC7);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1953), 1, 1);
    vehicle_life: 15;
    model_life: get_model_life(1945,1979);
    retire_early: get_retire_early(1945,1979);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_LARGE;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 16;
    passenger_capacity: 105;
    mail_capacity: 10;
    acceleration: 27;
    range: 1649;
    sound_effect: SOUND_TAKEOFF_JET_BIG;
  }
  graphics {
    default: DOUGLAS_DC7_sprites;
    purchase: DOUGLAS_DC7_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: DOUGLAS_DC7_cargo_subtype_text;
    passenger_capacity: DOUGLAS_DC7_cargo_subtype_capacity;
    speed: DOUGLAS_DC7_speed;
    running_cost_factor: DOUGLAS_DC7_running_cost_factor;
    sound_effect: DOUGLAS_DC7_sound_effect;

    cost_factor: 35;
    purchase_running_cost_factor: 7;
    purchase_speed: plane_speed_kmh(557);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, DOUGLAS_DC7)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, DOUGLAS_DC7)
  {
    property
    { range: 1649; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, DOUGLAS_DC7)
  {
    property
    { range: 2480; }
  }
}
