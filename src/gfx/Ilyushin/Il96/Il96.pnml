// 灰阶基底（占位复用 Airbus_A330_300 灰阶图）
#define IMAGEFILE  "src/gfx/Airbus/A330/A330-300/(0)Greyscale.png"
purchase_sprite(ILYUSHIN_IL96, 415, 1, 69, 34, -35, -17)
ILYUSHIN_IL96_sprite_layout_template(ILYUSHIN_IL96_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A330/A330-300/AirCanada.png"
ILYUSHIN_IL96_sprite_layout_template(ILYUSHIN_IL96_AirCanada)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A330/A330-300/AirEuropa.png"
ILYUSHIN_IL96_sprite_layout_template(ILYUSHIN_IL96_AirEuropa)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A330/A330-300/American.png"
ILYUSHIN_IL96_sprite_layout_template(ILYUSHIN_IL96_American)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A330/A330-300/Asiana.png"
ILYUSHIN_IL96_sprite_layout_template(ILYUSHIN_IL96_Asiana)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A330/A330-300/CatheyPacific.png"
ILYUSHIN_IL96_sprite_layout_template(ILYUSHIN_IL96_CatheyPacific)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL96_Greyscale, flight_state())
{
  15: ILYUSHIN_IL96_Greyscale_Climbing;
  18: ILYUSHIN_IL96_Greyscale_Flight;
  21: ILYUSHIN_IL96_Greyscale_Landing;
  22: ILYUSHIN_IL96_Greyscale_Touchdown;
      ILYUSHIN_IL96_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL96_AirCanada, flight_state())
{
  15: ILYUSHIN_IL96_AirCanada_Climbing;
  18: ILYUSHIN_IL96_AirCanada_Flight;
  21: ILYUSHIN_IL96_AirCanada_Landing;
  22: ILYUSHIN_IL96_AirCanada_Touchdown;
      ILYUSHIN_IL96_AirCanada_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL96_AirEuropa, flight_state())
{
  15: ILYUSHIN_IL96_AirEuropa_Climbing;
  18: ILYUSHIN_IL96_AirEuropa_Flight;
  21: ILYUSHIN_IL96_AirEuropa_Landing;
  22: ILYUSHIN_IL96_AirEuropa_Touchdown;
      ILYUSHIN_IL96_AirEuropa_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL96_American, flight_state())
{
  15: ILYUSHIN_IL96_American_Climbing;
  18: ILYUSHIN_IL96_American_Flight;
  21: ILYUSHIN_IL96_American_Landing;
  22: ILYUSHIN_IL96_American_Touchdown;
      ILYUSHIN_IL96_American_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL96_Asiana, flight_state())
{
  15: ILYUSHIN_IL96_Asiana_Climbing;
  18: ILYUSHIN_IL96_Asiana_Flight;
  21: ILYUSHIN_IL96_Asiana_Landing;
  22: ILYUSHIN_IL96_Asiana_Touchdown;
      ILYUSHIN_IL96_Asiana_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL96_CatheyPacific, flight_state())
{
  15: ILYUSHIN_IL96_CatheyPacific_Climbing;
  18: ILYUSHIN_IL96_CatheyPacific_Flight;
  21: ILYUSHIN_IL96_CatheyPacific_Landing;
  22: ILYUSHIN_IL96_CatheyPacific_Touchdown;
      ILYUSHIN_IL96_CatheyPacific_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL96_sprites, cargo_subtype)
{
  1: ILYUSHIN_IL96_AirCanada;
  2: ILYUSHIN_IL96_AirEuropa;
  3: ILYUSHIN_IL96_American;
  4: ILYUSHIN_IL96_Asiana;
  5: ILYUSHIN_IL96_CatheyPacific;
     ILYUSHIN_IL96_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL96_running_cost_factor, flight_state())
{
  plane_RC(166)
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL96_speed, flight_state())
{
  12..13: return plane_speed_kmh(281); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(483); // airplane climbing after take-off
      18: return plane_speed_kmh(926); // heading for tower contact point
  16..20: return plane_speed_kmh(443); // in flight
  21..22: return plane_speed_kmh(241); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL96_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL96_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_ILYUSHIN_IL96);
  1: string(STR_VLIV_AIR_CANADA);
  2: string(STR_VLIV_AIR_EUROPA);
  3: string(STR_VLIV_AMERICAN_AIRLINES);
  4: string(STR_VLIV_ASIANA_AIRLINES);
  5: string(STR_VLIV_CATHAY_PACIFIC);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL96_cargo_subtype_capacity, cargo_subtype)
{
  1: return 280;
  2: return 280;
  3: return 280;
  4: return 280;
  5: return 280;
     return 280;
}

item (FEAT_AIRCRAFT, ILYUSHIN_IL96)
{
  property
  {
    name: string(STR_AIRV_ILYUSHIN_IL96);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1992), 1, 1);
    vehicle_life: 25;
    model_life: get_model_life(1994,2050);
    retire_early: get_retire_early(1994,2050);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_LARGE;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 43;
    passenger_capacity: 280;
    mail_capacity: 28;
    acceleration: 27;
    range: 2000;
    sound_effect: SOUND_TAKEOFF_JET_BIG;
  }
  graphics {
    default: ILYUSHIN_IL96_sprites;
    purchase: ILYUSHIN_IL96_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: ILYUSHIN_IL96_cargo_subtype_text;
    passenger_capacity: ILYUSHIN_IL96_cargo_subtype_capacity;
    speed: ILYUSHIN_IL96_speed;
    running_cost_factor: ILYUSHIN_IL96_running_cost_factor;
    sound_effect: ILYUSHIN_IL96_sound_effect;

    cost_factor: 187;
    purchase_running_cost_factor: 166;
    purchase_speed: plane_speed_kmh(926);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, ILYUSHIN_IL96)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, ILYUSHIN_IL96)
  {
    property
    { range: 2000; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, ILYUSHIN_IL96)
  {
    property
    { range: 3000; }
  }
}
