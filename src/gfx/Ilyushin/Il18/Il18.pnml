switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL18_Greyscale, flight_state())
{
  15: ILYUSHIN_IL18_Greyscale_Climbing;
  18: ILYUSHIN_IL18_Greyscale_Flight;
  21: ILYUSHIN_IL18_Greyscale_Landing;
  22: ILYUSHIN_IL18_Greyscale_Touchdown;
      ILYUSHIN_IL18_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL18_AerArran, flight_state())
{
  15: ILYUSHIN_IL18_AerArran_Climbing;
  18: ILYUSHIN_IL18_AerArran_Flight;
  21: ILYUSHIN_IL18_AerArran_Landing;
  22: ILYUSHIN_IL18_AerArran_Touchdown;
      ILYUSHIN_IL18_AerArran_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL18_AirDeccan, flight_state())
{
  15: ILYUSHIN_IL18_AirDeccan_Climbing;
  18: ILYUSHIN_IL18_AirDeccan_Flight;
  21: ILYUSHIN_IL18_AirDeccan_Landing;
  22: ILYUSHIN_IL18_AirDeccan_Touchdown;
      ILYUSHIN_IL18_AirDeccan_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL18_AirDolomiti, flight_state())
{
  15: ILYUSHIN_IL18_AirDolomiti_Climbing;
  18: ILYUSHIN_IL18_AirDolomiti_Flight;
  21: ILYUSHIN_IL18_AirDolomiti_Landing;
  22: ILYUSHIN_IL18_AirDolomiti_Touchdown;
      ILYUSHIN_IL18_AirDolomiti_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL18_Airlinair, flight_state())
{
  15: ILYUSHIN_IL18_Airlinair_Climbing;
  18: ILYUSHIN_IL18_Airlinair_Flight;
  21: ILYUSHIN_IL18_Airlinair_Landing;
  22: ILYUSHIN_IL18_Airlinair_Touchdown;
      ILYUSHIN_IL18_Airlinair_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL18_AirNostrum, flight_state())
{
  15: ILYUSHIN_IL18_AirNostrum_Climbing;
  18: ILYUSHIN_IL18_AirNostrum_Flight;
  21: ILYUSHIN_IL18_AirNostrum_Landing;
  22: ILYUSHIN_IL18_AirNostrum_Touchdown;
      ILYUSHIN_IL18_AirNostrum_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL18_sprites, cargo_subtype)
{
  1: ILYUSHIN_IL18_AerArran;
  2: ILYUSHIN_IL18_AirDeccan;
  3: ILYUSHIN_IL18_AirDolomiti;
  4: ILYUSHIN_IL18_Airlinair;
  5: ILYUSHIN_IL18_AirNostrum;
     ILYUSHIN_IL18_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL18_running_cost_factor, flight_state())
{
  plane_RC(39)
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL18_speed, flight_state())
{
  12..13: return plane_speed_kmh(312); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(420); // airplane climbing after take-off
      18: return plane_speed_kmh(625); // heading for tower contact point
  16..20: return plane_speed_kmh(459); // in flight
  21..22: return plane_speed_kmh(263); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(244);
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL18_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL18_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_ILYUSHIN_IL18);
  1: string(STR_VLIV_AER_ARRAN_RINGED_DESIGN);
  2: string(STR_VLIV_AIR_DECCAN);
  3: string(STR_VLIV_AIR_DOLOMITI);
  4: string(STR_VLIV_AIRLINAIR_AIR_FRANCE);
  5: string(STR_VLIV_AIR_NOSTRUM_IBERIA_REGIONAL);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, ILYUSHIN_IL18_cargo_subtype_capacity, cargo_subtype)
{
  1: return 110;
  2: return 110;
  3: return 110;
  4: return 110;
  5: return 110;
     return 110;
}

item (FEAT_AIRCRAFT, ILYUSHIN_IL18)
{
  property
  {
    name: string(STR_AIRV_ILYUSHIN_IL18);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1957), 1, 1);
    vehicle_life: 11;
    model_life: get_model_life(1997,2024);
    retire_early: get_retire_early(1997,2024);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 16;
    passenger_capacity: 110;
    mail_capacity: 10;
    acceleration: 27;
    range: 1182;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: ILYUSHIN_IL18_sprites;
    purchase: ILYUSHIN_IL18_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: ILYUSHIN_IL18_cargo_subtype_text;
    passenger_capacity: ILYUSHIN_IL18_cargo_subtype_capacity;
    speed: ILYUSHIN_IL18_speed;
    running_cost_factor: ILYUSHIN_IL18_running_cost_factor;
    sound_effect: ILYUSHIN_IL18_sound_effect;

    cost_factor: 25;
    purchase_running_cost_factor: 39;
    purchase_speed: plane_speed_kmh(625);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, ILYUSHIN_IL18)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, ILYUSHIN_IL18)
  {
    property
    { range: 1182; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, ILYUSHIN_IL18)
  {
    property
    { range: 1783; }
  }
}
