// 灰阶基底（占位复用 ATR_72_500 灰阶图）
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/(0)Greyscale.png"
purchase_sprite(ILYUSHIN_IL18, 283, 1, 50, 23, -25, -12)
ILYUSHIN_IL18_sprite_layout_template(ILYUSHIN_IL18_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AerArran.png"
ILYUSHIN_IL18_sprite_layout_template(ILYUSHIN_IL18_AerArran)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AirDeccan.png"
ILYUSHIN_IL18_sprite_layout_template(ILYUSHIN_IL18_AirDeccan)
