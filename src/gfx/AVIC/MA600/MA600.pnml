// 灰阶基底（占位复用 ATR_72_500 灰阶图）

// 灰阶基底（占位复用 ATR_72_600 灰阶图）
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/(0)Greyscale.png"
purchase_sprite(AVIC_MA600, 283, 1, 50, 23, -25, -12)
AVIC_MA600_sprite_layout_template(AVIC_MA600_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AerArran.png"
AVIC_MA600_sprite_layout_template(AVIC_MA600_AerArran)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AirDeccan.png"
AVIC_MA600_sprite_layout_template(AVIC_MA600_AirDeccan)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AirDolomiti.png"
AVIC_MA600_sprite_layout_template(AVIC_MA600_AirDolomiti)
#undef IMAGEFILE
