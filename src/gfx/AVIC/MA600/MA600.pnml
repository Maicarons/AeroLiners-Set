AVIC_MA600_sprite_layout_template(AVIC_MA600_Airlinair)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/ATR/ATR72/72-500/AirNostrum.png"
AVIC_MA600_sprite_layout_template(AVIC_MA600_AirNostrum)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, AVIC_MA600_Greyscale, flight_state())
{
  15: AVIC_MA600_Greyscale_Climbing;
  18: AVIC_MA600_Greyscale_Flight;
  21: AVIC_MA600_Greyscale_Landing;
  22: AVIC_MA600_Greyscale_Touchdown;
      AVIC_MA600_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AVIC_MA600_AerArran, flight_state())
{
  15: AVIC_MA600_AerArran_Climbing;
  18: AVIC_MA600_AerArran_Flight;
  21: AVIC_MA600_AerArran_Landing;
  22: AVIC_MA600_AerArran_Touchdown;
      AVIC_MA600_AerArran_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AVIC_MA600_AirDeccan, flight_state())
{
  15: AVIC_MA600_AirDeccan_Climbing;
  18: AVIC_MA600_AirDeccan_Flight;
  21: AVIC_MA600_AirDeccan_Landing;
  22: AVIC_MA600_AirDeccan_Touchdown;
      AVIC_MA600_AirDeccan_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AVIC_MA600_AirDolomiti, flight_state())
{
  15: AVIC_MA600_AirDolomiti_Climbing;
  18: AVIC_MA600_AirDolomiti_Flight;
  21: AVIC_MA600_AirDolomiti_Landing;
  22: AVIC_MA600_AirDolomiti_Touchdown;
      AVIC_MA600_AirDolomiti_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, AVIC_MA600_Airlinair, flight_state())
{
  15: AVIC_MA600_Airlinair_Climbing;
  18: AVIC_MA600_Airlinair_Flight;
  21: AVIC_MA600_Airlinair_Landing;
  22: AVIC_MA600_Airlinair_Touchdown;
