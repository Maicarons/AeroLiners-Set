switch (FEAT_AIRCRAFT, SELF, AVIC_MA600_sprites, cargo_subtype)
{
  1: AVIC_MA600_AerArran;
  2: AVIC_MA600_AirDeccan;
  3: AVIC_MA600_AirDolomiti;
  4: AVIC_MA600_Airlinair;
  5: AVIC_MA600_AirNostrum;
     AVIC_MA600_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, AVIC_MA600_running_cost_factor, flight_state())
{
  plane_RC(39)
}

switch (FEAT_AIRCRAFT, SELF, AVIC_MA600_speed, flight_state())
{
  12..13: return plane_speed_kmh(215); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(289); // airplane climbing after take-off
      18: return plane_speed_kmh(430); // heading for tower contact point
  16..20: return plane_speed_kmh(316); // in flight
  21..22: return plane_speed_kmh(181); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(168);
}

switch (FEAT_AIRCRAFT, SELF, AVIC_MA600_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, AVIC_MA600_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_AVIC_MA600);
  1: string(STR_VLIV_AER_ARRAN_RINGED_DESIGN);
  2: string(STR_VLIV_AIR_DECCAN);
  3: string(STR_VLIV_AIR_DOLOMITI);
  4: string(STR_VLIV_AIRLINAIR_AIR_FRANCE);
  5: string(STR_VLIV_AIR_NOSTRUM_IBERIA_REGIONAL);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, AVIC_MA600_cargo_subtype_capacity, cargo_subtype)
{
  1: return 60;
  2: return 60;
  3: return 60;
  4: return 60;
  5: return 60;
     return 60;
}

item (FEAT_AIRCRAFT, AVIC_MA600)
{
  property
  {
    name: string(STR_AIRV_AVIC_MA600);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2010), 1, 1);
    vehicle_life: 11;
    model_life: get_model_life(1997,2024);
    retire_early: get_retire_early(1997,2024);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 16;
    passenger_capacity: 60;
    mail_capacity: 6;
    acceleration: 27;
    range: 260;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: AVIC_MA600_sprites;
    purchase: AVIC_MA600_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: AVIC_MA600_cargo_subtype_text;
    passenger_capacity: AVIC_MA600_cargo_subtype_capacity;
    speed: AVIC_MA600_speed;
    running_cost_factor: AVIC_MA600_running_cost_factor;
    sound_effect: AVIC_MA600_sound_effect;

    cost_factor: 18;
    purchase_running_cost_factor: 39;
    purchase_speed: plane_speed_kmh(430);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, AVIC_MA600)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, AVIC_MA600)
  {
    property
    { range: 260; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, AVIC_MA600)
  {
    property
    { range: 393; }
  }
}
