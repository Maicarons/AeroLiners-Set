{
  15: AVIC_MA600_AirNostrum_Climbing;
  18: AVIC_MA600_AirNostrum_Flight;
  21: AVIC_MA600_AirNostrum_Landing;
  22: AVIC_MA600_AirNostrum_Touchdown;
      AVIC_MA600_AirNostrum_Grounded;
