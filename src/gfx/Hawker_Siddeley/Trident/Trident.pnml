// 灰阶基底（占位复用 Boeing_727_200 灰阶图）
#define IMAGEFILE  "src/gfx/Boeing/B727/B727-200/(0)Greyscale.png"
purchase_sprite(HS_TRIDENT, 300, 3, 55, 21, -28, -11)
HS_TRIDENT_sprite_layout_template(HS_TRIDENT_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B727/B727-200/Aerolineas.png"
HS_TRIDENT_sprite_layout_template(HS_TRIDENT_Aerolineas)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B727/B727-200/AirAlgerie.png"
HS_TRIDENT_sprite_layout_template(HS_TRIDENT_AirAlgerie)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B727/B727-200/AirCanada.png"
HS_TRIDENT_sprite_layout_template(HS_TRIDENT_AirCanada)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B727/B727-200/AirFlorida.png"
HS_TRIDENT_sprite_layout_template(HS_TRIDENT_AirFlorida)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Boeing/B727/B727-200/AirFrance.png"
HS_TRIDENT_sprite_layout_template(HS_TRIDENT_AirFrance)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, HS_TRIDENT_Greyscale, flight_state())
{
  15: HS_TRIDENT_Greyscale_Climbing;
  18: HS_TRIDENT_Greyscale_Flight;
  21: HS_TRIDENT_Greyscale_Landing;
  22: HS_TRIDENT_Greyscale_Touchdown;
      HS_TRIDENT_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, HS_TRIDENT_Aerolineas, flight_state())
{
  15: HS_TRIDENT_Aerolineas_Climbing;
  18: HS_TRIDENT_Aerolineas_Flight;
  21: HS_TRIDENT_Aerolineas_Landing;
  22: HS_TRIDENT_Aerolineas_Touchdown;
      HS_TRIDENT_Aerolineas_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, HS_TRIDENT_AirAlgerie, flight_state())
{
  15: HS_TRIDENT_AirAlgerie_Climbing;
  18: HS_TRIDENT_AirAlgerie_Flight;
  21: HS_TRIDENT_AirAlgerie_Landing;
  22: HS_TRIDENT_AirAlgerie_Touchdown;
      HS_TRIDENT_AirAlgerie_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, HS_TRIDENT_AirCanada, flight_state())
{
  15: HS_TRIDENT_AirCanada_Climbing;
  18: HS_TRIDENT_AirCanada_Flight;
  21: HS_TRIDENT_AirCanada_Landing;
  22: HS_TRIDENT_AirCanada_Touchdown;
      HS_TRIDENT_AirCanada_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, HS_TRIDENT_AirFlorida, flight_state())
{
  15: HS_TRIDENT_AirFlorida_Climbing;
  18: HS_TRIDENT_AirFlorida_Flight;
  21: HS_TRIDENT_AirFlorida_Landing;
  22: HS_TRIDENT_AirFlorida_Touchdown;
      HS_TRIDENT_AirFlorida_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, HS_TRIDENT_AirFrance, flight_state())
{
  15: HS_TRIDENT_AirFrance_Climbing;
  18: HS_TRIDENT_AirFrance_Flight;
  21: HS_TRIDENT_AirFrance_Landing;
  22: HS_TRIDENT_AirFrance_Touchdown;
      HS_TRIDENT_AirFrance_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, HS_TRIDENT_sprites, cargo_subtype)
{
  1: HS_TRIDENT_Aerolineas;
  2: HS_TRIDENT_AirAlgerie;
  3: HS_TRIDENT_AirCanada;
  4: HS_TRIDENT_AirFlorida;
  5: HS_TRIDENT_AirFrance;
     HS_TRIDENT_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, HS_TRIDENT_running_cost_factor, flight_state())
{
  plane_RC(97)
}

switch (FEAT_AIRCRAFT, SELF, HS_TRIDENT_speed, flight_state())
{
  12..13: return plane_speed_kmh(289); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(515); // airplane climbing after take-off
      18: return plane_speed_kmh(999); // heading for tower contact point
  16..20: return plane_speed_kmh(459); // in flight
  21..22: return plane_speed_kmh(241); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

switch (FEAT_AIRCRAFT, SELF, HS_TRIDENT_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, HS_TRIDENT_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_HS_TRIDENT);
  1: string(STR_VLIV_AEROLINEAS_ARGENTINAS);
  2: string(STR_VLIV_AIR_ALGERIE);
  3: string(STR_VLIV_AIR_CANADA);
  4: string(STR_VLIV_AIR_FLORIDA);
  5: string(STR_VLIV_AIR_FRANCE);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, HS_TRIDENT_cargo_subtype_capacity, cargo_subtype)
{
  1: return 150;
  2: return 150;
  3: return 150;
  4: return 150;
  5: return 150;
     return 150;
}

item (FEAT_AIRCRAFT, HS_TRIDENT)
{
  property
  {
    name: string(STR_AIRV_HS_TRIDENT);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1964), 1, 1);
    vehicle_life: 25;
    model_life: get_model_life(1967,1984);
    retire_early: get_retire_early(1967,1984);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 22;
    passenger_capacity: 150;
    mail_capacity: 15;
    acceleration: 27;
    range: 701;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: HS_TRIDENT_sprites;
    purchase: HS_TRIDENT_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: HS_TRIDENT_cargo_subtype_text;
    passenger_capacity: HS_TRIDENT_cargo_subtype_capacity;
    speed: HS_TRIDENT_speed;
    running_cost_factor: HS_TRIDENT_running_cost_factor;
    sound_effect: HS_TRIDENT_sound_effect;

    cost_factor: 37;
    purchase_running_cost_factor: 97;
    purchase_speed: plane_speed_kmh(999);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, HS_TRIDENT)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, HS_TRIDENT)
  {
    property
    { range: 701; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, HS_TRIDENT)
  {
    property
    { range: 1050; }
  }
}
