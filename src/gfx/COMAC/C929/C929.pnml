COMAC_C929_sprite_layout_template(COMAC_C929_Iberia)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, COMAC_C929_Greyscale, flight_state())
{
  15: COMAC_C929_Greyscale_Climbing;
  18: COMAC_C929_Greyscale_Flight;
  21: COMAC_C929_Greyscale_Landing;
  22: COMAC_C929_Greyscale_Touchdown;
      COMAC_C929_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, COMAC_C929_AirChina, flight_state())
{
  15: COMAC_C929_AirChina_Climbing;
  18: COMAC_C929_AirChina_Flight;
  21: COMAC_C929_AirChina_Landing;
  22: COMAC_C929_AirChina_Touchdown;
      COMAC_C929_AirChina_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, COMAC_C929_Evelop, flight_state())
{
  15: COMAC_C929_Evelop_Climbing;
  18: COMAC_C929_Evelop_Flight;
  21: COMAC_C929_Evelop_Landing;
  22: COMAC_C929_Evelop_Touchdown;
      COMAC_C929_Evelop_Grounded;
}

