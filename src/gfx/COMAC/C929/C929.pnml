switch (FEAT_AIRCRAFT, SELF, COMAC_C929_sprites, cargo_subtype)
{
  1: COMAC_C929_AirChina;
  2: COMAC_C929_Evelop;
  3: COMAC_C929_Fiji;
  4: COMAC_C929_Finnair;
  5: COMAC_C929_Iberia;
     COMAC_C929_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, COMAC_C929_running_cost_factor, flight_state())
{
  plane_RC(259)
}

switch (FEAT_AIRCRAFT, SELF, COMAC_C929_speed, flight_state())
{
  12..13: return plane_speed_kmh(274); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(443); // airplane climbing after take-off
      18: return plane_speed_kmh(908); // heading for tower contact point
  16..20: return plane_speed_kmh(426); // in flight
  21..22: return plane_speed_kmh(241); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

switch (FEAT_AIRCRAFT, SELF, COMAC_C929_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, COMAC_C929_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_COMAC_C929);
  1: string(STR_VLIV_AIR_CHINA);
  2: string(STR_VLIV_EVELOP);
  3: string(STR_VLIV_FIJI_AIRWAYS);
  4: string(STR_VLIV_FINNAIR);
  5: string(STR_VLIV_IBERIA);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, COMAC_C929_cargo_subtype_capacity, cargo_subtype)
{
  1: return 280;
  2: return 280;
  3: return 280;
  4: return 280;
  5: return 280;
     return 280;
}

item (FEAT_AIRCRAFT, COMAC_C929)
{
  property
  {
    name: string(STR_AIRV_COMAC_C929);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2030), 1, 1);
    vehicle_life: 30;
    model_life: get_model_life(2015,2050);
    retire_early: get_retire_early(2015,2050);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_LARGE;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 43;
    passenger_capacity: 280;
    mail_capacity: 28;
    acceleration: 27;
    range: 2182;
    sound_effect: SOUND_TAKEOFF_JET_BIG;
  }
  graphics {
    default: COMAC_C929_sprites;
    purchase: COMAC_C929_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: COMAC_C929_cargo_subtype_text;
    passenger_capacity: COMAC_C929_cargo_subtype_capacity;
    speed: COMAC_C929_speed;
    running_cost_factor: COMAC_C929_running_cost_factor;
    sound_effect: COMAC_C929_sound_effect;

    cost_factor: 220;
    purchase_running_cost_factor: 191;
    purchase_speed: plane_speed_kmh(908);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, COMAC_C929)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, COMAC_C929)
  {
    property
    { range: 2182; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, COMAC_C929)
  {
    property
    { range: 3273; }
  }
}
