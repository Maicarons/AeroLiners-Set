// 灰阶基底（占位复用 Airbus_A350_900 灰阶图）
#define IMAGEFILE  "src/gfx/Airbus/A350/A350-900/(0)Greyscale.png"
purchase_sprite(COMAC_C929, 415, 1, 70, 35, -35, -18)
COMAC_C929_sprite_layout_template(COMAC_C929_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A350/A350-900/AirChina.png"
COMAC_C929_sprite_layout_template(COMAC_C929_AirChina)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Airbus/A350/A350-900/Evelop.png"
COMAC_C929_sprite_layout_template(COMAC_C929_Evelop)
#undef IMAGEFILE
