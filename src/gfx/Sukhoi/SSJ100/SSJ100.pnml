// 灰阶基底（占位复用 Embraer_E190STD 灰阶图）
#define IMAGEFILE  "src/gfx/Embraer/E190/E190STD/(0)Greyscale.png"
purchase_sprite(SUKHOI_SSJ100, 255, 1, 45, 21, -23, -11)
SUKHOI_SSJ100_sprite_layout_template(SUKHOI_SSJ100_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Embraer/E190/E190STD/Alitalia.png"
SUKHOI_SSJ100_sprite_layout_template(SUKHOI_SSJ100_Alitalia)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Embraer/E190/E190STD/BACityflyer.png"
SUKHOI_SSJ100_sprite_layout_template(SUKHOI_SSJ100_BACityflyer)
#undef IMAGEFILE
