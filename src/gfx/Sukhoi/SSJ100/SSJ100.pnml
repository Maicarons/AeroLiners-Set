SUKHOI_SSJ100_sprite_layout_template(SUKHOI_SSJ100_KLMCityhopper)
#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, SUKHOI_SSJ100_Greyscale, flight_state())
{
  15: SUKHOI_SSJ100_Greyscale_Climbing;
  18: SUKHOI_SSJ100_Greyscale_Flight;
  21: SUKHOI_SSJ100_Greyscale_Landing;
  22: SUKHOI_SSJ100_Greyscale_Touchdown;
      SUKHOI_SSJ100_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, SUKHOI_SSJ100_Alitalia, flight_state())
{
  15: SUKHOI_SSJ100_Alitalia_Climbing;
  18: SUKHOI_SSJ100_Alitalia_Flight;
  21: SUKHOI_SSJ100_Alitalia_Landing;
  22: SUKHOI_SSJ100_Alitalia_Touchdown;
      SUKHOI_SSJ100_Alitalia_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, SUKHOI_SSJ100_BACityflyer, flight_state())
{
  15: SUKHOI_SSJ100_BACityflyer_Climbing;
  18: SUKHOI_SSJ100_BACityflyer_Flight;
  21: SUKHOI_SSJ100_BACityflyer_Landing;
  22: SUKHOI_SSJ100_BACityflyer_Touchdown;
      SUKHOI_SSJ100_BACityflyer_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, SUKHOI_SSJ100_BulgariaAir, flight_state())
{
  15: SUKHOI_SSJ100_BulgariaAir_Climbing;
  18: SUKHOI_SSJ100_BulgariaAir_Flight;
  21: SUKHOI_SSJ100_BulgariaAir_Landing;
  22: SUKHOI_SSJ100_BulgariaAir_Touchdown;
      SUKHOI_SSJ100_BulgariaAir_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, SUKHOI_SSJ100_HOP, flight_state())
{
  15: SUKHOI_SSJ100_HOP_Climbing;
  18: SUKHOI_SSJ100_HOP_Flight;
  21: SUKHOI_SSJ100_HOP_Landing;
  22: SUKHOI_SSJ100_HOP_Touchdown;
      SUKHOI_SSJ100_HOP_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, SUKHOI_SSJ100_KLMCityhopper, flight_state())
{
  15: SUKHOI_SSJ100_KLMCityhopper_Climbing;
  18: SUKHOI_SSJ100_KLMCityhopper_Flight;
  21: SUKHOI_SSJ100_KLMCityhopper_Landing;
  22: SUKHOI_SSJ100_KLMCityhopper_Touchdown;
      SUKHOI_SSJ100_KLMCityhopper_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, SUKHOI_SSJ100_sprites, cargo_subtype)
{
  1: SUKHOI_SSJ100_Alitalia;
  2: SUKHOI_SSJ100_BACityflyer;
  3: SUKHOI_SSJ100_BulgariaAir;
  4: SUKHOI_SSJ100_HOP;
  5: SUKHOI_SSJ100_KLMCityhopper;
     SUKHOI_SSJ100_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, SUKHOI_SSJ100_running_cost_factor, flight_state())
{
  plane_RC(29)
}

switch (FEAT_AIRCRAFT, SELF, SUKHOI_SSJ100_speed, flight_state())
{
  12..13: return plane_speed_kmh(241); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(410); // airplane climbing after take-off
      18: return plane_speed_kmh(870); // heading for tower contact point
  16..20: return plane_speed_kmh(427); // in flight
  21..22: return plane_speed_kmh(273); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(201);
}

switch (FEAT_AIRCRAFT, SELF, SUKHOI_SSJ100_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, SUKHOI_SSJ100_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_SUKHOI_SSJ100);
  1: string(STR_VLIV_ALITALIA);
  2: string(STR_VLIV_BRITISH_AIRWAYS_UNION_FLAG);
  3: string(STR_VLIV_BULGARIA_AIR);
  4: string(STR_VLIV_HOP);
  5: string(STR_VLIV_KLM_CITYHOPPER);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, SUKHOI_SSJ100_cargo_subtype_capacity, cargo_subtype)
{
  1: return 92;
  2: return 92;
  3: return 92;
  4: return 92;
  5: return 92;
     return 92;
}

item (FEAT_AIRCRAFT, SUKHOI_SSJ100)
{
  property
  {
    name: string(STR_AIRV_SUKHOI_SSJ100);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(2011), 1, 1);
    vehicle_life: 30;
    model_life: get_model_life(2004,2259);
    retire_early: get_retire_early(2004,2259);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 19;
    passenger_capacity: 92;
    mail_capacity: 9;
    acceleration: 27;
    range: 554;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: SUKHOI_SSJ100_sprites;
    purchase: SUKHOI_SSJ100_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: SUKHOI_SSJ100_cargo_subtype_text;
    passenger_capacity: SUKHOI_SSJ100_cargo_subtype_capacity;
    speed: SUKHOI_SSJ100_speed;
    running_cost_factor: SUKHOI_SSJ100_running_cost_factor;
    sound_effect: SUKHOI_SSJ100_sound_effect;

    cost_factor: 65;
    purchase_running_cost_factor: 29;
    purchase_speed: plane_speed_kmh(870);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, SUKHOI_SSJ100)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, SUKHOI_SSJ100)
  {
    property
    { range: 554; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, SUKHOI_SSJ100)
  {
    property
    { range: 831; }
  }
}
