switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_COMET_sprites, cargo_subtype)
{
  1: DEHAVILLAND_COMET_Adria;
  2: DEHAVILLAND_COMET_BavariaGermanair;
  3: DEHAVILLAND_COMET_BritishAirways;
  4: DEHAVILLAND_COMET_BritishCaledonian;
  5: DEHAVILLAND_COMET_Cyprus;
     DEHAVILLAND_COMET_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_COMET_running_cost_factor, flight_state())
{
  plane_RC(53)
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_COMET_speed, flight_state())
{
  // [speed-constant] 巡航速度恒定，不随飞行状态变化。
  // OpenTTD 将速度属性回调（CB36）的结果缓存于 cached_max_speed，仅在载具
  // 创建、机场状态切换和读档时刷新；按 flight_state 返回不同速度会让缓存
  // 卡在旧值上（起飞后停在跑道速度；读档后跑道速度变成巡航速度）。
  // 滑行/进近/刹车减速由游戏原生状态机按巡航速度自动派生，无需在此压低。
  return plane_speed_kmh(790); // cruise, keep in sync with purchase_speed
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_COMET_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_COMET_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_DEHAVILLAND_COMET);
  1: string(STR_VLIV_ADRIA_AIRWAYS);
  2: string(STR_VLIV_BAVARIA_GERMANAIR);
  3: string(STR_VLIV_BRITISH_AIRWAYS_NEGUS);
  4: string(STR_VLIV_BRITISH_CALEDONIAN);
  5: string(STR_VLIV_CYPRUS_AIRWAYS);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_COMET_cargo_subtype_capacity, cargo_subtype)
{
  1: return 90;
  2: return 90;
  3: return 90;
  4: return 90;
  5: return 90;
     return 90;
}

item (FEAT_AIRCRAFT, DEHAVILLAND_COMET)
{
  property
  {
    name: string(STR_AIRV_DEHAVILLAND_COMET);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1952), 1, 1);
    vehicle_life: 12;
    model_life: get_model_life(1967,1989);
    retire_early: get_retire_early(1967,1989);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 10;
    passenger_capacity: 81;
    mail_capacity: 7;
    acceleration: 27;
    range: 1345;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: DEHAVILLAND_COMET_sprites;
    purchase: DEHAVILLAND_COMET_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: DEHAVILLAND_COMET_cargo_subtype_text;
    passenger_capacity: DEHAVILLAND_COMET_cargo_subtype_capacity;
    speed: DEHAVILLAND_COMET_speed;
    running_cost_factor: DEHAVILLAND_COMET_running_cost_factor;
    sound_effect: DEHAVILLAND_COMET_sound_effect;

    cost_factor: 37;
    purchase_running_cost_factor: 53;
    purchase_speed: plane_speed_kmh(790);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, DEHAVILLAND_COMET)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, DEHAVILLAND_COMET)
  {
    property
    { range: 1207; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, DEHAVILLAND_COMET)
  {
    property
    { range: 1811; }
  }
}
