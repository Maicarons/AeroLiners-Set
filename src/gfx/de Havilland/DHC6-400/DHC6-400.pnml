#undef IMAGEFILE

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_DHC6_400_Greyscale, flight_state())
{
  15: DEHAVILLAND_DHC6_400_Greyscale_Climbing;
  18: DEHAVILLAND_DHC6_400_Greyscale_Flight;
  21: DEHAVILLAND_DHC6_400_Greyscale_Landing;
  22: DEHAVILLAND_DHC6_400_Greyscale_Touchdown;
      DEHAVILLAND_DHC6_400_Greyscale_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_DHC6_400_AirBaltic, flight_state())
{
  15: DEHAVILLAND_DHC6_400_AirBaltic_Climbing;
  18: DEHAVILLAND_DHC6_400_AirBaltic_Flight;
  21: DEHAVILLAND_DHC6_400_AirBaltic_Landing;
  22: DEHAVILLAND_DHC6_400_AirBaltic_Touchdown;
      DEHAVILLAND_DHC6_400_AirBaltic_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_DHC6_400_AirBerlin, flight_state())
{
  15: DEHAVILLAND_DHC6_400_AirBerlin_Climbing;
  18: DEHAVILLAND_DHC6_400_AirBerlin_Flight;
  21: DEHAVILLAND_DHC6_400_AirBerlin_Landing;
  22: DEHAVILLAND_DHC6_400_AirBerlin_Touchdown;
      DEHAVILLAND_DHC6_400_AirBerlin_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_DHC6_400_AirNiugini, flight_state())
{
  15: DEHAVILLAND_DHC6_400_AirNiugini_Climbing;
  18: DEHAVILLAND_DHC6_400_AirNiugini_Flight;
  21: DEHAVILLAND_DHC6_400_AirNiugini_Landing;
  22: DEHAVILLAND_DHC6_400_AirNiugini_Touchdown;
      DEHAVILLAND_DHC6_400_AirNiugini_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_DHC6_400_AustrianArrows, flight_state())
{
  15: DEHAVILLAND_DHC6_400_AustrianArrows_Climbing;
  18: DEHAVILLAND_DHC6_400_AustrianArrows_Flight;
  21: DEHAVILLAND_DHC6_400_AustrianArrows_Landing;
  22: DEHAVILLAND_DHC6_400_AustrianArrows_Touchdown;
      DEHAVILLAND_DHC6_400_AustrianArrows_Grounded;
