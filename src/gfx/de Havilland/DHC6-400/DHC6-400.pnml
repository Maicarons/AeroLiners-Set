// 灰阶基底（占位复用 Bombardier_Dash_8_400Q 灰阶图）
#define IMAGEFILE  "src/gfx/Bombardier/Dash_8/Dash_8-400Q/(0)Greyscale.png"
purchase_sprite(DEHAVILLAND_DHC6_400, 290, 1, 48, 22, -24, -11)
DEHAVILLAND_DHC6_400_sprite_layout_template(DEHAVILLAND_DHC6_400_Greyscale)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Bombardier/Dash_8/Dash_8-400Q/AirBaltic.png"
DEHAVILLAND_DHC6_400_sprite_layout_template(DEHAVILLAND_DHC6_400_AirBaltic)
#undef IMAGEFILE
#define IMAGEFILE  "src/gfx/Bombardier/Dash_8/Dash_8-400Q/AirBerlin.png"
