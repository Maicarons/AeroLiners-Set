switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_DHC6_400_Brussels, flight_state())
{
  15: DEHAVILLAND_DHC6_400_Brussels_Climbing;
  18: DEHAVILLAND_DHC6_400_Brussels_Flight;
  21: DEHAVILLAND_DHC6_400_Brussels_Landing;
  22: DEHAVILLAND_DHC6_400_Brussels_Touchdown;
      DEHAVILLAND_DHC6_400_Brussels_Grounded;
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_DHC6_400_sprites, cargo_subtype)
{
  1: DEHAVILLAND_DHC6_400_AirBaltic;
  2: DEHAVILLAND_DHC6_400_AirBerlin;
  3: DEHAVILLAND_DHC6_400_AirNiugini;
  4: DEHAVILLAND_DHC6_400_AustrianArrows;
  5: DEHAVILLAND_DHC6_400_Brussels;
     DEHAVILLAND_DHC6_400_Greyscale;
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_DHC6_400_running_cost_factor, flight_state())
{
  plane_RC(35)
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_DHC6_400_speed, flight_state())
{
  12..13: return plane_speed_kmh(122); // airplane waiting for take-off clearance, airplane taking off
      15: return plane_speed_kmh(183); // airplane climbing after take-off
      18: return plane_speed_kmh(337); // heading for tower contact point
  16..20: return plane_speed_kmh(162); // in flight
  21..22: return plane_speed_kmh(114); // airplane landing, airplane braking after touchdown
          return plane_speed_kmh(101);
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_DHC6_400_sound_effect, extra_callback_info1)
{
  SOUND_EVENT_START     : sound("src/sound/av_turbogo.wav");
  SOUND_EVENT_TOUCHDOWN : sound("src/sound/av_landturbo.wav");
                          return CB_RESULT_NO_SOUND;
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_DHC6_400_cargo_subtype_text, cargo_subtype)
{
  0: string(STR_VLIV_DEHAVILLAND_DHC6_400);
  1: string(STR_VLIV_AIR_BALTIC);
  2: string(STR_VLIV_AIR_BERLIN);
  3: string(STR_VLIV_AIR_NIUGINI);
  4: string(STR_VLIV_AUSTRIAN_ARROWS);
  5: string(STR_VLIV_BRUSSELS_AIRLINES);
     return CB_RESULT_NO_TEXT;
}

switch (FEAT_AIRCRAFT, SELF, DEHAVILLAND_DHC6_400_cargo_subtype_capacity, cargo_subtype)
{
  1: return 19;
  2: return 19;
  3: return 19;
  4: return 19;
  5: return 19;
     return 19;
}

item (FEAT_AIRCRAFT, DEHAVILLAND_DHC6_400)
{
  property
  {
    name: string(STR_AIRV_DEHAVILLAND_DHC6_400);
    climates_available: get_climates_available();
    introduction_date: date(get_plane_year(1986), 1, 1);
    vehicle_life: 25;
    model_life: get_model_life(2000,2016);
    retire_early: get_retire_early(2000,2016);

    sprite_id: SPRITE_ID_NEW_AIRCRAFT;
    aircraft_type: AIRCRAFT_TYPE_SMALL;
    misc_flags: bitmask(AIRCRAFT_FLAG_2CC);
    cargo_allow_refit: [PASS, TOUR];
    reliability_decay: 20;
    loading_speed: 29;
    passenger_capacity: 19;
    mail_capacity: 2;
    acceleration: 27;
    range: 236;
    sound_effect: SOUND_TAKEOFF_JET;
  }
  graphics {
    default: DEHAVILLAND_DHC6_400_sprites;
    purchase: DEHAVILLAND_DHC6_400_purchase_sprite;
    colour_mapping: PALETTE_CC_FIRST;

    cargo_subtype_text: DEHAVILLAND_DHC6_400_cargo_subtype_text;
    passenger_capacity: DEHAVILLAND_DHC6_400_cargo_subtype_capacity;
    speed: DEHAVILLAND_DHC6_400_speed;
    running_cost_factor: DEHAVILLAND_DHC6_400_running_cost_factor;
    sound_effect: DEHAVILLAND_DHC6_400_sound_effect;

    cost_factor: 22;
    purchase_running_cost_factor: 35;
    purchase_speed: plane_speed_kmh(337);
  }
}

if (Ranges == 0)
{
  item (FEAT_AIRCRAFT, DEHAVILLAND_DHC6_400)
  {
    property
    { range: 0; }
  }
}

if (Ranges == 1)
{
  item (FEAT_AIRCRAFT, DEHAVILLAND_DHC6_400)
  {
    property
    { range: 236; }
  }
}

if (Ranges == 2)
{
  item (FEAT_AIRCRAFT, DEHAVILLAND_DHC6_400)
  {
    property
    { range: 353; }
  }
}
